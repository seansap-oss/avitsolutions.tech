    year: '2026',
    stack: ['KDS', 'Counter POS', 'Realtime', 'Loyalty'],
    visual: 'linear-gradient(135deg, rgba(189,117,64,.32), rgba(9,9,13,.92) 50%, rgba(255,98,0,.20))',
    icon: '☕',
    link: '/projects/brews-bites',
  },
  {
    category: 'websites design',
    eyebrow: 'MUSEUM EXPERIENCE SITE',
    title: 'WWII Museum Website',
    thumbnail: '/portfolio-media/wwii-museum-hero.webp',
    subtitle: 'Retro-inspired visual storytelling, gallery movement, owner profile links, and content-first museum landing experience.',
    status: 'Website design',
    year: '2026',
    stack: ['Storytelling', 'Gallery', 'Retro UI', 'Responsive'],
    visual: 'linear-gradient(135deg, rgba(166,132,86,.30), rgba(13,12,10,.95) 52%, rgba(224,214,178,.15))',
    icon: 'Ⅱ',
    link: '/projects/wwii-museum',
  },
  {
    category: 'websites business',
    eyebrow: 'ECOMMERCE + GALLERY',
