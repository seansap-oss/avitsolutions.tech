    thumbnail: '/portfolio-media/avit-portfolio-hero.webp',
    subtitle: 'A cinematic AV + IT identity system designed to show professional engineering, UX, and software capability in one place.',
    status: 'Live build',
    year: '2026',
    stack: ['Astro', 'UI/UX', 'Motion', 'Portfolio CMS-ready'],
