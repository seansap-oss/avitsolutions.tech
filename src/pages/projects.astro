    year: '2026',
    stack: ['Dashboard', 'Reports', 'Modules', 'Admin UX'],
    visual: 'linear-gradient(135deg, rgba(43,119,255,.28), rgba(8,11,20,.94) 58%, rgba(100,255,218,.18))',
    icon: 'SS',
    link: '/projects/syncstation',
  },
  {
    category: 'software business',
    eyebrow: 'CLINIC LAN SOFTWARE',
    title: 'Clinic Reception + Lab System',
    thumbnail: '/portfolio-media/clinic-system-hero.webp',
    subtitle: 'Local network workflow for reception, lab, reports, manager settings, daily closing rules, and payment controls.',
    status: 'Local app',
    year: '2026',
    stack: ['LAN workflow', 'Billing', 'Lab reports', 'Manager controls'],
    visual: 'linear-gradient(135deg, rgba(255,198,86,.22), rgba(9,12,20,.95) 55%, rgba(75,223,255,.20))',
    icon: '+',
    link: '/projects/clinic-system',
  },
  {
