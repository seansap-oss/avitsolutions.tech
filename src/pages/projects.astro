    subtitle: 'Member directory, calendar, notice board, admin approvals, event workflows, and future Android/iOS app structure.',
    status: 'Product build',
    year: '2026',
    stack: ['Directory', 'Calendar', 'Supabase', 'Mobile app'],
    visual: 'linear-gradient(135deg, rgba(45,255,190,.25), rgba(10,17,28,.92) 55%, rgba(105,74,255,.28))',
    icon: 'A',
    link: '/projects/ambi',
  },
  {
    category: 'software business automation',
    eyebrow: 'OPERATIONS DASHBOARD',
    title: 'SyncStation',
    thumbnail: '/portfolio-media/syncstation-hero.webp',
    subtitle: 'A modular business control center concept for reports, modules, dashboards, reliable build tracking, and operational workflows.',
