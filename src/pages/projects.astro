  },
  {
    category: 'av automation',
    eyebrow: 'AV CONTROL CONCEPT',
    title: 'Affordable Lecture Theatre Kit',
    thumbnail: '/portfolio-media/lecture-theatre-kit-hero.webp',
    subtitle: 'Low-cost AV control direction for schools and colleges: projector, screen, DSP, lighting, camera, wireless mics, and tablet UI.',
    status: 'Concept system',
    year: '2026',
    stack: ['AV control', 'DSP', 'Tablet UI', 'Education'],
    visual: 'linear-gradient(135deg, rgba(115,95,255,.27), rgba(7,10,18,.94) 54%, rgba(63,224,255,.18))',
    icon: 'AV',
    link: '/projects/lecture-theatre-kit',
  },
  {
    category: 'software mobile government',
    eyebrow: 'COMMAND WORKFLOW APP',
    title: 'CommandTrack',
    thumbnail: '/portfolio-media/commandtrack-hero.webp',
    subtitle: 'Police/security force app direction with patrol grids, incident logs, handover, GPS, media uploads, and control room workflow.',
    status: 'Concept product',
    year: '2026',
    stack: ['Mobile UX', 'Control room', 'Reports', 'GPS workflow'],
    visual: 'linear-gradient(135deg, rgba(64,142,255,.28), rgba(6,10,18,.95) 56%, rgba(255,66,86,.18))',
    icon: 'CT',
    link: '/projects/commandtrack',
  },
];

const capabilityBands = [
  'AV integration',
  'Control UX',
  'Admin panels',
  'Mobile apps',
  'Realtime systems',
  'Dashboards',
  'Portfolio websites',
  'Business workflow tools',
];
---

<Layout title="Projects & Case Studies" description="Explore AviT Solutions portfolio case studies across websites, apps, business software, community platforms, smart classrooms, AV kits and automation systems." canonical="/projects" image="/og-image.svg">
  <section class="portfolio-hero">
    <div class="portfolio-grid-bg" aria-hidden="true"></div>
    <div class="container portfolio-hero-inner">
      <div class="portfolio-copy">
        <div class="section-label">Projects Studio</div>
        <h1>Built like a portfolio. Presented like a product lab.</h1>
        <p>
          A curated project wall for AV systems, websites, mobile apps, admin panels, local business tools, and control-system ideas. This section now connects to case-study pages that can grow with your real screenshots, AV install photos, UX screens, and build notes.
        </p>
      </div>
      <div class="portfolio-panel" aria-label="Portfolio summary">
        <div class="panel-orbit"></div>
        <div class="panel-line"><span>Focus</span><strong>AV + IT + Software</strong></div>
        <div class="panel-line"><span>Style</span><strong>Premium UX portfolio</strong></div>
        <div class="panel-line"><span>Proof</span><strong>Projects, not client logos</strong></div>
      </div>
    </div>
  </section>

  <section class="portfolio-filters-wrap">
    <div class="container">
      <div class="filter-bar" id="filterBar" aria-label="Project filters">
        <button class="filter-btn active" data-filter="all">All Work</button>
        <button class="filter-btn" data-filter="websites">Websites</button>
        <button class="filter-btn" data-filter="software">Software</button>
        <button class="filter-btn" data-filter="mobile">Mobile Apps</button>
        <button class="filter-btn" data-filter="av">AV Systems</button>
        <button class="filter-btn" data-filter="business">Business Tools</button>
        <button class="filter-btn" data-filter="automation">Automation</button>
      </div>
    </div>
  </section>

  <section class="portfolio-section section">
    <div class="container">
      <div class="portfolio-layout">
        <aside class="portfolio-sidebar">
          <div class="sticky-card">
            <div class="section-label">Capability Map</div>
            <h2>One portfolio for physical spaces and digital products.</h2>
            <p>
              The goal is to make visitors understand your rare combination: AV engineering, networking, control logic, UI/UX, and full-stack product building.
            </p>
            <div class="capability-list">
              {capabilityBands.map((item) => <span>{item}</span>)}
            </div>
          </div>
        </aside>

        <div class="project-wall" id="projectsGrid">
          {portfolioItems.map((project, index) => (
            <article class="portfolio-card project-item" data-category={project.category} style={`--card-bg: ${project.visual}; --delay: ${index * 45}ms`}>
              <a href={project.link} class="portfolio-card-link" aria-label={`Open ${project.title}`}>
                <div class="card-visual media-card-visual">
                  <img src={project.thumbnail} alt={`${project.title} portfolio preview`} loading="lazy" />
                  <div class="card-grid"></div>
                  <div class="card-icon">{project.icon}</div>
                  <div class="card-scan"></div>
                </div>
                <div class="card-body">
                  <div class="card-topline">
                    <span>{project.eyebrow}</span>
                    <em>{project.year}</em>
                  </div>
                  <h3>{project.title}</h3>
                  <p>{project.subtitle}</p>
                  <div class="stack-row">
                    {project.stack.map((tag) => <span>{tag}</span>)}
                  </div>
                </div>
                <div class="card-footer">
                  <span>{project.status}</span>
                  <strong>Open case study →</strong>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="legal-proof section">
    <div class="container proof-grid">
      <div>
        <div class="section-label">Credibility without risk</div>
        <h2>We show expertise without misusing past employer client logos.</h2>
      </div>
      <p>
        This project system is intentionally built around capabilities, sectors, and owned portfolio work. Past experience can be described honestly in your profile, while the project wall focuses on what AviT Solutions can design, build, and support.
      </p>
    </div>
  </section>

  <CTASection
    title="Project Case Studies Are Now Ready"
    subtitle="Open any project card to view a structured case study with realistic installed visuals. Real screenshots and installation photos can replace these assets later using the same filenames."
    ctaText="Start a Project"
    ctaLink="/contact"
  />
</Layout>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 82% 10%, rgba(124, 89, 255, 0.13), transparent 32rem),
      radial-gradient(circle at 12% 5%, rgba(48, 221, 255, 0.10), transparent 30rem),
      #03060b;
  }

  .portfolio-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(7rem, 12vw, 10rem) 0 clamp(3.5rem, 7vw, 6rem);
    border-bottom: 1px solid rgba(255,255,255,.07);
  }

  .portfolio-grid-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(72, 211, 255, .055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(72, 211, 255, .055) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(circle at 50% 36%, black, transparent 72%);
    opacity: .65;
  }

  .portfolio-hero::before,
  .portfolio-hero::after {
    content: '';
    position: absolute;
    border-radius: 999px;
    filter: blur(16px);
    opacity: .65;
    pointer-events: none;
  }

  .portfolio-hero::before {
    width: 44vw;
    height: 44vw;
    right: -12vw;
    top: -18vw;
    background: radial-gradient(circle, rgba(102,80,255,.34), transparent 62%);
  }

  .portfolio-hero::after {
    width: 35vw;
    height: 35vw;
    left: -12vw;
    bottom: -18vw;
    background: radial-gradient(circle, rgba(38,211,255,.22), transparent 65%);
  }

  .portfolio-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .portfolio-copy h1 {
    max-width: 980px;
    margin: .6rem 0 1.25rem;
    font-size: clamp(3rem, 7.2vw, 7rem);
    line-height: .92;
    letter-spacing: -.075em;
  }

  .portfolio-copy p {
    max-width: 760px;
    color: rgba(235,245,255,.70);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.75;
  }

  .portfolio-panel {
    position: relative;
    overflow: hidden;
    padding: 1.2rem;
    min-height: 380px;
    border-radius: 36px;
    border: 1px solid rgba(255,255,255,.10);
    background:
      radial-gradient(circle at 70% 20%, rgba(125,89,255,.26), transparent 34%),
      linear-gradient(180deg, rgba(255,255,255,.075), rgba(255,255,255,.022));
    box-shadow: 0 35px 100px rgba(0,0,0,.36), inset 0 0 0 1px rgba(255,255,255,.04);
    backdrop-filter: blur(24px);
  }

  .panel-orbit {
    height: 190px;
    margin-bottom: 1rem;
    border-radius: 30px;
    background:
      radial-gradient(circle at 50% 50%, rgba(71,221,255,.36), transparent 11%),
      repeating-radial-gradient(circle at 50% 50%, rgba(126,95,255,.34) 0 2px, transparent 2px 26px),
      linear-gradient(135deg, rgba(44, 221, 255, .12), rgba(125, 89, 255, .12));
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);
    animation: pulsePanel 4s ease-in-out infinite;
  }

  @keyframes pulsePanel {
    0%, 100% { filter: hue-rotate(0deg) brightness(1); }
    50% { filter: hue-rotate(18deg) brightness(1.15); }
  }

  .panel-line {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem .2rem;
    border-top: 1px solid rgba(255,255,255,.08);
  }

  .panel-line span {
    color: rgba(235,245,255,.54);
    font-size: .82rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-weight: 800;
  }

  .panel-line strong {
    text-align: right;
    color: white;
  }

  .portfolio-filters-wrap {
    position: sticky;
    top: 72px;
    z-index: 20;
    padding: .85rem 0;
    background: rgba(3,6,11,.72);
    border-bottom: 1px solid rgba(255,255,255,.06);
    backdrop-filter: blur(18px);
  }

  .filter-bar {
    display: flex;
    gap: .55rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filter-bar::-webkit-scrollbar { display: none; }

  .filter-btn {
    flex: 0 0 auto;
    padding: .78rem 1.1rem;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 999px;
    background: rgba(255,255,255,.04);
    color: rgba(236,245,255,.72);
    font: inherit;
    font-size: .86rem;
    font-weight: 800;
    cursor: pointer;
    transition: transform .22s ease, background .22s ease, border-color .22s ease, color .22s ease;
  }

  .filter-btn:hover,
  .filter-btn.active {
    transform: translateY(-2px);
    color: #031018;
    border-color: transparent;
    background: linear-gradient(135deg, #48dcff, #8c65ff);
  }

  .portfolio-section { padding-top: clamp(3rem, 6vw, 5rem); }

  .portfolio-layout {
    display: grid;
    grid-template-columns: minmax(250px, .34fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .sticky-card {
    position: sticky;
    top: 160px;
    padding: 1.35rem;
    border-radius: 30px;
    border: 1px solid rgba(255,255,255,.09);
    background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.018));
    box-shadow: 0 30px 90px rgba(0,0,0,.22);
  }

  .sticky-card h2 {
    margin: .8rem 0 1rem;
    font-size: clamp(1.45rem, 2.5vw, 2.35rem);
    line-height: 1.04;
    letter-spacing: -.05em;
  }

  .sticky-card p {
    color: rgba(235,245,255,.64);
    line-height: 1.7;
  }

  .capability-list {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    margin-top: 1.25rem;
  }

  .capability-list span {
    padding: .58rem .72rem;
    border-radius: 999px;
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.08);
    color: rgba(236,245,255,.72);
    font-size: .78rem;
    font-weight: 700;
  }

  .project-wall {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .portfolio-card {
    animation: cardIn .55s ease both;
    animation-delay: var(--delay);
  }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .portfolio-card.hidden { display: none; }

  .portfolio-card-link {
    position: relative;
    display: grid;
    min-height: 520px;
    grid-template-rows: 1fr auto auto;
    overflow: hidden;
    border-radius: 34px;
    border: 1px solid rgba(255,255,255,.10);
    background: linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.018));
    color: white;
    text-decoration: none;
    box-shadow: 0 30px 80px rgba(0,0,0,.24);
    transition: transform .34s ease, border-color .34s ease, box-shadow .34s ease;
  }

  .portfolio-card-link:hover {
    transform: translateY(-10px);
    border-color: rgba(96,220,255,.36);
    box-shadow: 0 45px 110px rgba(0,0,0,.34), 0 0 42px rgba(94, 216, 255, .08);
  }

  .card-visual {
    position: relative;
    min-height: 235px;
    overflow: hidden;
    background: var(--card-bg);
  }

  .card-visual::before {
    content: '';
    position: absolute;
    inset: -40%;
    background: conic-gradient(from 180deg, transparent, rgba(255,255,255,.20), transparent 28%);
    animation: rotateGlow 8s linear infinite;
    opacity: .40;
  }

  @keyframes rotateGlow { to { transform: rotate(1turn); } }

  .card-grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: radial-gradient(circle at 50% 50%, black, transparent 72%);
  }

  .card-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 950;
    letter-spacing: -.08em;
    color: rgba(255,255,255,.90);
    text-shadow: 0 0 38px rgba(79, 221, 255, .32);
  }

  .card-scan {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    top: 26%;
    background: linear-gradient(90deg, transparent, rgba(108,231,255,.95), transparent);
    animation: scan 3.4s ease-in-out infinite;
  }

  @keyframes scan {
    0%,100% { transform: translateY(-40px); opacity: 0; }
    45%,65% { opacity: 1; }
    80% { transform: translateY(170px); opacity: 0; }
  }

  .card-body { padding: 1.35rem; }

  .card-topline,
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-topline span {
    color: #5ce7ff;
    font-size: .68rem;
    letter-spacing: .15em;
    font-weight: 900;
  }

  .card-topline em {
    color: rgba(235,245,255,.48);
    font-style: normal;
    font-size: .8rem;
    font-weight: 800;
  }

  .card-body h3 {
    margin: .7rem 0 .65rem;
    font-size: clamp(1.45rem, 2.8vw, 2.05rem);
    line-height: 1;
    letter-spacing: -.05em;
  }

  .card-body p {
    min-height: 84px;
    color: rgba(235,245,255,.66);
    line-height: 1.62;
  }

  .stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-top: 1.1rem;
  }

  .stack-row span {
    padding: .45rem .6rem;
    border-radius: 999px;
    background: rgba(255,255,255,.055);
    border: 1px solid rgba(255,255,255,.08);
    color: rgba(236,245,255,.72);
    font-size: .72rem;
    font-weight: 800;
  }

  .card-footer {
    padding: 1rem 1.35rem 1.25rem;
    border-top: 1px solid rgba(255,255,255,.08);
  }

  .card-footer span {
    color: rgba(236,245,255,.54);
    font-size: .82rem;
    font-weight: 800;
  }

  .card-footer strong {
    color: white;
    font-size: .88rem;
  }

  .legal-proof {
    border-top: 1px solid rgba(255,255,255,.06);
    border-bottom: 1px solid rgba(255,255,255,.06);
    background: linear-gradient(180deg, rgba(255,255,255,.025), rgba(255,255,255,.01));
  }

  .proof-grid {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: center;
  }

  .proof-grid h2 {
    margin-top: .6rem;
    font-size: clamp(1.8rem, 4vw, 3.6rem);
    line-height: .98;
    letter-spacing: -.06em;
  }

  .proof-grid p {
    color: rgba(235,245,255,.66);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  @media (max-width: 1050px) {
    .portfolio-hero-inner,
    .portfolio-layout,
    .proof-grid { grid-template-columns: 1fr; }
    .portfolio-panel { min-height: auto; }
    .sticky-card { position: relative; top: auto; }
  }

  @media (max-width: 760px) {
    .portfolio-filters-wrap { top: 64px; }
    .project-wall { grid-template-columns: 1fr; }
    .portfolio-card-link { min-height: 480px; border-radius: 28px; }
    .card-body p { min-height: auto; }
    .portfolio-copy h1 { font-size: clamp(2.7rem, 16vw, 4.6rem); }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projects = document.querySelectorAll('.project-item');

  const hashToFilter = {
    '#websites': 'websites',
    '#software': 'software',
    '#mobile-apps': 'mobile',
    '#av-systems': 'av',
    '#business-tools': 'business',
    '#automation': 'automation',
  };

  function applyFilter(filter) {
    filterBtns.forEach((btn) => btn.classList.toggle('active', btn.dataset.filter === filter));

    projects.forEach((project) => {
      const categories = project.dataset.category || '';
      const show = filter === 'all' || categories.split(' ').includes(filter);
      project.classList.toggle('hidden', !show);
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter || 'all';
      applyFilter(filter);
      history.replaceState(null, '', filter === 'all' ? window.location.pathname : `#${filter}`);
    });
  });

  const hash = window.location.hash;
  if (hash && hashToFilter[hash]) {
    applyFilter(hashToFilter[hash]);
  }
</script>
