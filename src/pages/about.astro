---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';

const disciplines = [
  { label: 'Control', value: 'Crestron · AMX · Extron', note: 'Room logic, UI flows, presets, automation, relays, touch panels, and user-first control.' },
  { label: 'Networked AV', value: 'AV-over-IP · Cisco-level networking', note: 'Signal paths designed with IP discipline, VLAN thinking, addressing, and serviceability.' },
  { label: 'Audio + VC', value: 'DSP · Mics · Cameras · Teams Rooms', note: 'Boardrooms, classrooms, lecture theatres, and collaboration spaces engineered for clarity.' },
  { label: 'Software', value: 'Web · Mobile · Admin systems', note: 'Custom portals, dashboards, community platforms, and operational tools that extend the AV layer.' },
];

const timeline = [
  { year: '2008+', title: 'AV foundation', copy: 'Formal audiovisual training, installation discipline, site standards, rack work, projection, display, cabling, and commissioning.' },
  { year: '2011+', title: 'Enterprise field delivery', copy: 'Service, support, commissioning, and project work across corporate, education, healthcare, events, and public venue environments.' },
  { year: '2012+', title: 'Control systems', copy: 'Manufacturer training and hands-on programming across AMX, Crestron, Extron, touch panels, source routing, and room automation.' },
  { year: '2017+', title: 'Networked collaboration', copy: 'AV/IT convergence: Cisco-style infrastructure thinking, video conferencing, DSP, multi-room support, and campus-scale reliability.' },
  { year: '2023+', title: 'Software product layer', copy: 'Full-stack websites, mobile apps, admin panels, ERP-style workflows, AI-assisted tooling, and custom interfaces for real businesses.' },
  { year: 'Now', title: 'AviT Solutions', copy: 'A combined AV, IT, UI/UX, and software studio built for clients who want one partner from hardware to interface.' },
];

const credentials = [
  'Crestron DigitalMedia / design background',
  'AMX ACE installer and programming foundation',
  'Extron XTP and professional AV systems exposure',
  'Q-SYS / audio DSP workflow understanding',
  'Cisco networking fundamentals at CCNA level',
  'Hikvision CCTV and security system experience',
  'Photoshop, UI/UX design, and front-end product design',
  '15+ years across service, projects, support, and commissioning',
];

const sectors = [
  'Corporate boardrooms',
  'Smart classrooms',
  'Lecture theatres',
  'Healthcare facilities',
  'Public venues',
  'Retail signage',
  'Government-style environments',
  'Residential automation',
];

const principles = [
  { n: '01', title: 'Engineer the invisible', copy: 'A great room feels simple because the hard work is hidden: network, audio, routing, control, and fail-safe logic.' },
  { n: '02', title: 'UI is part of the system', copy: 'The touch panel, website, admin console, and mobile app are not decoration. They decide whether people can actually use the technology.' },
  { n: '03', title: 'Design for the technician too', copy: 'Documentation, labels, signal flow, predictable logic, and remote support matter after the handover.' },
  { n: '04', title: 'Be honest about experience', copy: 'We present professional background and industry exposure clearly, without implying direct client ownership where work came through previous employers.' },
];
---

<Layout title="About the Founder" description="Meet the AviT Solutions founder: 15+ years across AV systems, control programming, networked AV, UI/UX design, websites, apps and custom software delivery." canonical="/about" image="/og-image.svg">
  <section class="founder-hero section">
    <div class="founder-orbit founder-orbit-a"></div>
    <div class="founder-orbit founder-orbit-b"></div>

    <div class="container founder-hero-grid">
      <div class="founder-copy reveal-up">
        <div class="section-label">About AviT Solutions</div>
        <h1 class="founder-title" data-text-key="about-page-title">
          Built by an AV engineer who also designs the interface.
        </h1>
        <p class="founder-lead" data-text-key="about-page-subtitle">
          AviT Solutions brings together audiovisual engineering, networking, UI/UX design, and custom software development — so the room, the rack, the network, and the screen interface feel like one complete system.
        </p>
        <div class="founder-actions">
          <a class="btn btn-primary magnetic" href="/projects">View Case Studies</a>
          <a class="btn btn-secondary magnetic" href="/contact">Start a Project</a>
        </div>
      </div>

      <div class="founder-console reveal-up" aria-label="Founder capability console">
        <img class="founder-console-photo" src="/portfolio-media/avit-portfolio-admin.webp" alt="AviT realistic engineering workspace" loading="lazy" />
        <div class="founder-console-grade"></div>
        <div class="console-topbar">
          <span></span><span></span><span></span>
          <strong>AviT_ENGINEERING_PROFILE</strong>
        </div>
        <div class="console-stage">
          <div class="console-ring"></div>
          <div class="console-core">
            <span>AV</span>
            <small>IT</small>
          </div>
          <div class="console-beam beam-one"></div>
          <div class="console-beam beam-two"></div>
          <div class="console-node node-a">DSP</div>
          <div class="console-node node-b">UX</div>
          <div class="console-node node-c">IP</div>
          <div class="console-node node-d">CTRL</div>
        </div>
        <div class="console-metrics">
          <div><strong>15+</strong><span>Years field experience</span></div>
          <div><strong>4</strong><span>Core disciplines</span></div>
          <div><strong>1</strong><span>Integrated delivery mindset</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="authority-band">
    <div class="container authority-strip reveal-up">
      <span>AV Integration</span>
      <span>Control Systems</span>
      <span>Networking</span>
      <span>DSP Audio</span>
      <span>UI/UX</span>
      <span>Web + Mobile Apps</span>
      <span>Admin Platforms</span>
    </div>
  </section>

  <section class="section founder-story-section">
    <div class="container story-grid">
      <div class="story-sticky reveal-up">
        <div class="section-label">Founder Authority</div>
        <h2 class="section-title story-title">Not a normal portfolio. A systems mindset.</h2>
        <p class="story-intro">
          Most AV companies stop at hardware. Most web studios stop at screens. AviT Solutions is built in the gap between both.
        </p>
      </div>
      <div class="story-body reveal-up">
        <p>
          The foundation comes from more than <strong>15 years of AV and IT field work</strong>: service calls, rack rooms, projector installs, commissioning, control programming, user support, and live environments where the system has to work when people walk into the room.
        </p>
        <p>
          That background now extends into <strong>custom software and interface design</strong>: websites, mobile apps, admin portals, business dashboards, community platforms, and workflow tools. The goal is not to make technology look complicated. The goal is to make complex systems feel calm, reliable, and easy to control.
        </p>
        <p>
          AviT Solutions can speak to the equipment side and the software side in the same conversation: microphones, DSP, cameras, displays, control processors, network design, user interface, admin workflow, and the final client experience.
        </p>
        <div class="safe-note">
          <strong>Experience note:</strong> Some enterprise and public-sector exposure was delivered through previous employers and integration partners. AviT Solutions presents this as professional experience, not as direct client endorsement or direct brand ownership.
        </div>
      </div>
    </div>
  </section>

  <section class="section discipline-section">
    <div class="container">
      <div class="section-label">Capability Stack</div>
      <h2 class="section-title">Four disciplines, one delivery language.</h2>
      <p class="section-subtitle">This is what makes AviT different from a standard website studio or a standard AV contractor.</p>
      <div class="discipline-grid reveal-up">
        {disciplines.map((item) => (
          <article class="discipline-card tilt-card">
            <span>{item.label}</span>
            <h3>{item.value}</h3>
            <p>{item.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section timeline-section">
    <div class="container timeline-layout">
      <div class="timeline-heading reveal-up">
        <div class="section-label">Journey</div>
        <h2 class="section-title">From field engineering to product design.</h2>
        <p class="section-subtitle">A career path shaped by practical installation work, support pressure, control logic, and modern software delivery.</p>
      </div>
      <div class="timeline-rail reveal-up">
        {timeline.map((item) => (
          <article class="timeline-item">
            <div class="timeline-year">{item.year}</div>
            <div class="timeline-card tilt-card">
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section proof-section">
    <div class="container proof-grid">
      <div class="proof-panel reveal-up">
        <div class="section-label">Technical Proof</div>
        <h2>Credentials and working exposure.</h2>
        <div class="credential-list">
          {credentials.map((item) => <span>{item}</span>)}
        </div>
      </div>
      <div class="proof-panel reveal-up">
        <div class="section-label">Environment Exposure</div>
        <h2>Built for real spaces, not just slides.</h2>
        <div class="sector-cloud">
          {sectors.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section principles-section">
    <div class="container">
      <div class="section-label">Working Principles</div>
      <h2 class="section-title">How AviT Solutions thinks.</h2>
      <div class="principles-grid reveal-up">
        {principles.map((item) => (
          <article class="principle-card tilt-card">
            <span>{item.n}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Need a room, platform, or system that feels properly engineered?"
    subtitle="Tell us what you want to build. We can help shape the AV scope, software workflow, interface direction, and delivery plan."
    ctaText="Start a Project"
    ctaLink="/contact"
  />
</Layout>

<style>
  .founder-hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(5rem, 10vw, 9rem);
    padding-bottom: clamp(4rem, 8vw, 8rem);
    background:
      radial-gradient(circle at 15% 10%, rgba(0, 184, 212, 0.18), transparent 34%),
      radial-gradient(circle at 80% 20%, rgba(98, 68, 255, 0.16), transparent 32%),
      linear-gradient(180deg, var(--bg-primary), var(--bg-secondary));
  }

  .founder-orbit {
    position: absolute;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 999px;
    pointer-events: none;
    opacity: 0.6;
  }

  .founder-orbit-a {
    width: 520px;
    height: 520px;
    right: -180px;
    top: 8%;
    animation: slow-spin 34s linear infinite;
  }

  .founder-orbit-b {
    width: 380px;
    height: 380px;
    left: -170px;
    bottom: -120px;
    animation: slow-spin 42s linear infinite reverse;
  }

  @keyframes slow-spin {
    to { transform: rotate(360deg); }
  }

  .founder-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .founder-title {
    font-size: clamp(2.8rem, 7vw, 6.8rem);
    line-height: 0.92;
    letter-spacing: -0.08em;
    max-width: 870px;
    margin-bottom: 1.5rem;
  }

  .founder-lead {
    max-width: 720px;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.7vw, 1.25rem);
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .founder-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .founder-console {
    position: relative;
    border: 1px solid rgba(255,255,255,0.1);
    background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.025));
    border-radius: 30px;
    box-shadow: 0 30px 90px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.12);
    overflow: hidden;
    min-height: 560px;
  }

  .console-topbar {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    color: var(--text-tertiary);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  .console-topbar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255,255,255,0.28);
  }

  .console-topbar strong {
    margin-left: auto;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--accent);
  }

  .console-stage {
    position: relative;
    height: 390px;
    display: grid;
    place-items: center;
    background:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 34px 34px;
    overflow: hidden;
  }

  .console-stage::after {
    content: '';
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 184, 212, 0.18), transparent 60%);
    filter: blur(20px);
  }

  .console-ring {
    position: absolute;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    border: 1px dashed rgba(0, 184, 212, 0.38);
    animation: slow-spin 22s linear infinite;
  }

  .console-core {
    position: relative;
    z-index: 2;
    width: 150px;
    height: 150px;
    border-radius: 36px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(0,184,212,0.98), rgba(91,115,255,0.82));
    color: #061014;
    font-weight: 950;
    font-size: 3.3rem;
    letter-spacing: -0.12em;
    box-shadow: 0 0 60px rgba(0,184,212,0.28);
  }

  .console-core small {
    position: absolute;
    right: 22px;
    bottom: 18px;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }

  .console-beam {
    position: absolute;
    height: 1px;
    width: 72%;
    background: linear-gradient(90deg, transparent, rgba(0,184,212,0.72), transparent);
    z-index: 1;
  }

  .beam-one { transform: rotate(28deg); }
  .beam-two { transform: rotate(-31deg); }

  .console-node {
    position: absolute;
    z-index: 3;
    padding: 0.55rem 0.75rem;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    background: rgba(10, 11, 12, 0.72);
    backdrop-filter: blur(14px);
    color: var(--text-primary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .node-a { top: 20%; left: 15%; }
  .node-b { top: 23%; right: 12%; }
  .node-c { bottom: 22%; left: 18%; }
  .node-d { bottom: 18%; right: 14%; }

  .console-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .console-metrics div {
    padding: 1.35rem 1rem;
    border-right: 1px solid rgba(255,255,255,0.08);
  }

  .console-metrics div:last-child { border-right: 0; }
  .console-metrics strong { display:block; font-size: 1.65rem; line-height:1; color: var(--accent); }
  .console-metrics span { display:block; color: var(--text-secondary); font-size: 0.78rem; line-height:1.35; margin-top:0.45rem; }

  .authority-band {
    padding: 0 0 2.5rem;
    background: var(--bg-secondary);
  }

  .authority-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .authority-strip span,
  .sector-cloud span,
  .credential-list span {
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.045);
    border-radius: 999px;
    color: var(--text-secondary);
  }

  .authority-strip span {
    padding: 0.8rem 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .story-sticky { position: sticky; top: 110px; }
  .story-title { text-align: left; margin-bottom: 1.25rem; }
  .story-intro { color: var(--text-secondary); line-height: 1.8; font-size: 1.05rem; }

  .story-body {
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.9;
  }

  .story-body p { margin-bottom: 1.35rem; }
  .story-body strong { color: var(--text-primary); }

  .safe-note {
    padding: 1.35rem;
    border-radius: 20px;
    background: rgba(0,184,212,0.08);
    border: 1px solid rgba(0,184,212,0.18);
    color: var(--text-secondary);
  }

  .safe-note strong { color: var(--accent); }

  .discipline-section,
  .principles-section { background: var(--bg-secondary); }

  .discipline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }

  .discipline-card,
  .principle-card,
  .timeline-card,
  .proof-panel {
    border: 1px solid rgba(255,255,255,0.08);
    background: linear-gradient(180deg, rgba(255,255,255,0.07), rgba(255,255,255,0.025));
    border-radius: 24px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
  }

  .discipline-card {
    padding: 1.5rem;
    min-height: 260px;
  }

  .discipline-card span,
  .principle-card span {
    display: inline-flex;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .discipline-card h3,
  .principle-card h3,
  .timeline-card h3 {
    font-size: 1.08rem;
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }

  .discipline-card p,
  .principle-card p,
  .timeline-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .timeline-section {
    background:
      radial-gradient(circle at 20% 20%, rgba(0,184,212,0.1), transparent 34%),
      var(--bg-primary);
  }

  .timeline-layout {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .timeline-heading .section-title,
  .timeline-heading .section-subtitle { text-align: left; margin-left: 0; }

  .timeline-rail {
    position: relative;
    padding-left: 1.5rem;
  }

  .timeline-rail::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: linear-gradient(var(--accent), rgba(255,255,255,0.08));
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
    position: relative;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -1.74rem;
    top: 1.1rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 22px rgba(0,184,212,0.8);
  }

  .timeline-year {
    color: var(--accent);
    font-weight: 900;
    font-size: 0.85rem;
    padding-top: 1rem;
  }

  .timeline-card { padding: 1.25rem; }

  .proof-section { background: var(--bg-tertiary); }

  .proof-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .proof-panel { padding: clamp(1.5rem, 3vw, 2.5rem); }
  .proof-panel h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); line-height: 1.05; letter-spacing: -0.05em; margin-bottom: 1.5rem; }

  .credential-list,
  .sector-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .credential-list span,
  .sector-cloud span {
    padding: 0.7rem 0.9rem;
    font-size: 0.82rem;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }

  .principle-card { padding: 1.5rem; min-height: 245px; }

  @media (max-width: 1060px) {
    .founder-hero-grid,
    .story-grid,
    .timeline-layout,
    .proof-grid { grid-template-columns: 1fr; }
    .story-sticky { position: static; }
    .discipline-grid,
    .principles-grid { grid-template-columns: repeat(2, 1fr); }
    .founder-console { min-height: auto; }
  }

  @media (max-width: 640px) {
    .founder-hero { padding-top: 4rem; }
    .founder-title { font-size: clamp(2.5rem, 16vw, 4rem); }
    .founder-actions { flex-direction: column; }
    .founder-actions .btn { width: 100%; justify-content: center; }
    .console-stage { height: 330px; }
    .console-metrics { grid-template-columns: 1fr; }
    .console-metrics div { border-right: 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .console-metrics div:last-child { border-bottom: 0; }
    .discipline-grid,
    .principles-grid { grid-template-columns: 1fr; }
    .timeline-item { grid-template-columns: 1fr; gap: 0.25rem; }
    .timeline-year { padding-top: 0; }
  }

  .founder-console-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.94) contrast(.98) brightness(.96);
    z-index: 0;
  }

  .founder-console-grade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(4,8,14,.22), rgba(4,8,14,.82));
    z-index: 1;
  }

  .founder-console .console-topbar,
  .founder-console .console-stage,
  .founder-console .console-metrics {
    position: relative;
    z-index: 2;
  }

</style>
