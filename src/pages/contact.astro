<script>
  const laneData = {
    av: {
      label: 'AV Integration',
      projectType: 'AV Integration',
      scope: [
        'Room type and system purpose',
        'Displays, audio, cameras and control',
        'Network and cabling conditions',
        'Timeline and installation constraints'
      ]
    },
    software: {
      label: 'Software / App',
      projectType: 'Custom Software / ERP',
      scope: [
        'Users, roles and approval workflow',
        'Admin dashboard and reporting needs',
        'Database, hosting and login requirements',
        'Mobile, desktop or hybrid delivery plan'
      ]
    },
    website: {
      label: 'Website / Ecommerce',
      projectType: 'Website / Ecommerce',
      scope: [
        'Brand direction and page structure',
        'Portfolio, shop, gallery or booking flow',
        'Admin update requirements',
        'SEO, hosting and launch timeline'
      ]
    },
    automation: {
      label: 'Automation / Control',
      projectType: 'Control System / Automation',
      scope: [
        'Devices to control and user interface type',
        'Relay, IP, serial, IR or API control paths',
        'Schedules, scenes and fail-safe behavior',
        'Remote support and documentation needs'
      ]
    }
  };

  const buttons = document.querySelectorAll('.lane-button');
  const selectedLane = document.getElementById('selectedLane');
  const projectType = document.getElementById('projectType');
  const timeline = document.getElementById('timeline');
  const budget = document.getElementById('budget');
  const scopePreview = document.getElementById('scopePreview');
  const briefText = document.getElementById('briefText');
  const briefSummary = document.getElementById('briefSummary');
  const formStatus = document.getElementById('formStatus');

  function updateBrief() {
    const checks = Array.from(document.querySelectorAll('input[name="scope"]:checked')).map((item) => item.value);
    const summary = `${projectType.value || 'Project'} enquiry • ${timeline.value || 'Flexible timeline'} • ${budget.value || 'Budget not decided'}${checks.length ? ' • Includes: ' + checks.join(', ') : ''}`;
    briefText.textContent = summary;
    briefSummary.value = summary;
    formStatus.textContent = checks.length ? `${checks.length} Selected` : 'Ready';
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const lane = laneData[button.dataset.lane];
      buttons.forEach((item) => item.classList.remove('active'));
      button.classList.add('active');
      selectedLane.value = lane.label;
      projectType.value = lane.projectType;
      scopePreview.innerHTML = `<span>Suggested scope</span><ul>${lane.scope.map((item) => `<li>${item}</li>`).join('')}</ul>`;
      updateBrief();
    });
  });

  document.querySelectorAll('#contactForm input, #contactForm select, #contactForm textarea').forEach((field) => {
    field.addEventListener('input', updateBrief);
    field.addEventListener('change', updateBrief);
  });

  updateBrief();

  const form = document.getElementById('contactForm');
  const success = document.getElementById('formSuccess');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    updateBrief();
    const data = new FormData(form);
    const btn = form.querySelector('.form-submit');
    const original = btn.innerHTML;
    btn.disabled = true;
    btn.textContent = 'Sending brief...';
    formStatus.textContent = 'Sending';

    try {
      const resp = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' }
      });

      if (resp.ok) {
        form.style.display = 'none';
        success.style.display = 'block';
      } else {
        throw new Error('Form submission failed');
      }
    } catch {
      btn.disabled = false;
      btn.innerHTML = original;
      formStatus.textContent = 'Email Directly';
      const mailSubject = encodeURIComponent('AviT Solutions Project Inquiry');
      const mailBody = encodeURIComponent(`Project Brief:\n${briefSummary.value}\n\nPlease describe your project here.`);
      window.location.href = `mailto:info@avitsolutions.tech?subject=${mailSubject}&body=${mailBody}`;
    }
  });
</script>
