---
import Layout from '../layouts/Layout.astro';
import ImageCard from '../components/ImageCard.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout>
  <section class="section page-hero">
    <div class="container" style="text-align: center;">
      <div class="section-label">AV Solutions</div>
      <h1 class="section-title" style="font-size: clamp(2.5rem, 5vw, 3.5rem);">
        Audiovisual Integration
      </h1>
      <p class="section-subtitle" style="margin: 0 auto 0;">
        From concept to commissioning — we design, supply, install, and support AV systems for any environment.
      </p>
    </div>
  </section>

  <section id="business" class="section" style="padding-top: 0;">
    <div class="container">
      <div class="service-block glass" style="margin-bottom: 2rem;">
        <div class="service-grid">
          <div class="service-content">
            <span class="section-label">Business</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);">Enterprise-Grade AV for the Modern Workplace</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
              We design and install AV systems that empower collaboration, impress clients, and streamline operations. Every solution is engineered to integrate seamlessly with existing IT infrastructure.
            </p>
            <ul class="service-list">
              <li>Boardrooms & executive conference rooms</li>
              <li>Huddle rooms & flexible meeting spaces</li>
              <li>Auditoriums & town hall spaces</li>
              <li>Digital signage & wayfinding</li>
              <li>Unified communications (Teams, Zoom, Webex)</li>
              <li>Video walls & projection systems</li>
              <li>Wireless presentation & BYOD</li>
            </ul>
          </div>
          <div class="service-visual">
            <ImageCard
              key="av-business"
              src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&h=600&fit=crop&q=80"
              alt="Modern corporate boardroom with AV screens and conferencing equipment"
              caption="Enterprise Boardroom AV"
            />
          </div>
        </div>
      </div>

      <div id="government" class="service-block glass" style="margin-bottom: 2rem;">
        <div class="service-grid reverse">
          <div class="service-content">
            <span class="section-label">Government</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);">Secure, Reliable, Certified AV for Public Sector</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
              We deliver AV and communication systems that meet the highest standards of security, redundancy, and compliance. Built for mission-critical government environments.
            </p>
            <ul class="service-list">
              <li>Council chambers & legislative halls</li>
              <li>Emergency operations centers</li>
              <li>Command & control rooms</li>
              <li>Classified briefing facilities</li>
              <li>Secure video conferencing (SIPR/NIPR)</li>
              <li>Public address & emergency notification</li>
              <li>Redundant AV infrastructure</li>
            </ul>
          </div>
          <div class="service-visual">
            <ImageCard
              key="av-government"
              src="https://images.unsplash.com/photo-1577412647305-991150c7d163?w=800&h=600&fit=crop&q=80"
              alt="Government council chamber with voting panels and secure AV systems"
              caption="Secure Council Chambers"
            />
          </div>
        </div>
      </div>

      <div id="education" class="service-block glass" style="margin-bottom: 2rem;">
        <div class="service-grid">
          <div class="service-content">
            <span class="section-label">Education</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);">Smart Classrooms & Campus AV Solutions</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
              Transform learning environments with interactive AV technology that engages students and empowers educators. From lecture halls to hybrid classrooms, we build systems that enhance education.
            </p>
            <ul class="service-list">
              <li>Smart classrooms & interactive displays</li>
              <li>Lecture capture & streaming systems</li>
              <li>Hybrid/remote learning AV</li>
              <li>Campus-wide digital signage</li>
              <li>Library & study space AV</li>
              <li>Multi-zone audio distribution</li>
              <li>Centralized AV management</li>
            </ul>
          </div>
          <div class="service-visual">
            <ImageCard
              key="av-education"
              src="https://images.unsplash.com/photo-1509062522246-3755977927d7?w=800&h=600&fit=crop&q=80"
              alt="Smart classroom with interactive display, projector, and AV equipment for hybrid learning"
              caption="Smart Classroom AV"
            />
          </div>
        </div>
      </div>

      <div id="healthcare" class="service-block glass" style="margin-bottom: 2rem;">
        <div class="service-grid reverse">
          <div class="service-content">
            <span class="section-label">Healthcare</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);">AV Systems for Medical & Healthcare Environments</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
              Purpose-built AV solutions for healthcare — from telemedicine and surgical video to patient entertainment and staff communication. Designed for reliability in clinical environments.
            </p>
            <ul class="service-list">
              <li>Telemedicine & video conferencing</li>
              <li>Surgical video routing & recording</li>
              <li>Patient room entertainment systems</li>
              <li>Staff communication & paging</li>
              <li>Medical training & simulation AV</li>
              <li>Waiting room digital signage</li>
              <li>Wayfinding & information displays</li>
            </ul>
          </div>
          <div class="service-visual">
            <ImageCard
              key="av-healthcare"
              src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=800&h=600&fit=crop&q=80"
              alt="Telemedicine video consultation — doctor on screen with medical equipment"
              caption="Healthcare Telemedicine AV"
            />
          </div>
        </div>
      </div>

      <div id="entertainment" class="service-block glass" style="margin-bottom: 2rem;">
        <div class="service-grid">
          <div class="service-content">
            <span class="section-label">Entertainment</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);">Immersive AV for Venues & Events</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
              Create unforgettable experiences with high-impact AV systems for entertainment venues, event spaces, and cultural institutions. From intimate clubs to large-scale venues.
            </p>
            <ul class="service-list">
              <li>Concert & live event sound systems</li>
              <li>LED video walls & projection mapping</li>
              <li>Theater & performing arts AV</li>
              <li>Nightclub & bar audio systems</li>
              <li>Exhibition & museum interactive displays</li>
              <li>Outdoor festival & event rigs</li>
              <li>Lighting control & show automation</li>
            </ul>
          </div>
          <div class="service-visual">
            <ImageCard
              key="av-entertainment"
              src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=800&h=600&fit=crop&q=80"
              alt="Live concert venue with stage lighting, LED walls, and professional sound system"
              caption="Concert & Event Venue AV"
            />
          </div>
        </div>
      </div>

      <div id="hospitality" class="service-block glass">
        <div class="service-grid reverse">
          <div class="service-content">
            <span class="section-label">Hospitality</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);">Elevated Guest Experiences Through AV</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
              Impress guests and streamline operations with elegant AV systems for hotels, resorts, restaurants, and event venues. Technology that enhances, never intrudes.
            </p>
            <ul class="service-list">
              <li>Hotel guest room entertainment</li>
              <li>Conference & ballroom AV systems</li>
              <li>Restaurant & bar audio/visual</li>
              <li>Pool & outdoor entertainment</li>
              <li>Lobby & reception digital displays</li>
              <li>Background music distribution</li>
              <li>Centralized control & management</li>
            </ul>
          </div>
          <div class="service-visual">
            <ImageCard
              key="av-hospitality"
              src="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800&h=600&fit=crop&q=80"
              alt="Luxury hotel lobby with digital displays, ambient audio, and conference AV systems"
              caption="Hotel & Hospitality AV"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="section-label">Our Process</div>
      <h2 class="section-title">From Design to Completion</h2>
      <p class="section-subtitle" style="margin-bottom: 3rem;">
        A proven methodology that ensures every project is delivered on time, on budget, and beyond expectations.
      </p>

      <div class="process-track">
        <div class="process-step">
          <div class="process-number">01</div>
          <h3>Discovery & Design</h3>
          <p>We learn your goals, map requirements, and create a detailed system design and scope of work.</p>
        </div>
        <div class="process-connector"></div>
        <div class="process-step">
          <div class="process-number">02</div>
          <h3>Engineering & Procurement</h3>
          <p>We engineer the solution, source all equipment from trusted manufacturers, and pre-configure systems.</p>
        </div>
        <div class="process-connector"></div>
        <div class="process-step">
          <div class="process-number">03</div>
          <h3>Installation & Integration</h3>
          <p>Professional on-site installation with minimal disruption. Full integration with your existing IT environment.</p>
        </div>
        <div class="process-connector"></div>
        <div class="process-step">
          <div class="process-number">04</div>
          <h3>Commissioning & Support</h3>
          <p>Thorough testing, staff training, and ongoing support to ensure your system performs flawlessly.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Design Your AV System"
    subtitle="Tell us about your space and needs. We'll design a solution that fits."
    ctaText="Start Your AV Project"
    ctaLink="/contact"
  />
</Layout>

<style>
  .page-hero {
    padding-bottom: 2rem;
  }

  .service-block {
    padding: 3rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--glass-border);
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .service-grid.reverse {
    direction: rtl;
  }

  .service-grid.reverse > * {
    direction: ltr;
  }

  .service-list {
    list-style: none;
    color: var(--text-secondary);
    line-height: 2;
  }

  .service-list li {
    position: relative;
    padding-left: 1.25rem;
  }

  .service-list li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .service-visual {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .service-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-lg);
  }

  .process-track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .process-step {
    padding: 2rem;
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    transition: all var(--transition-base);
  }

  .process-step:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }

  .process-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--accent);
    opacity: 0.4;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .process-step h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .process-step p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .process-connector {
    display: none;
  }

  @media (max-width: 1024px) {
    .process-track {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .service-block {
      padding: 2rem 1.5rem;
    }

    .service-grid, .service-grid.reverse {
      grid-template-columns: 1fr;
      direction: ltr;
      gap: 1.5rem;
    }

    .service-grid.reverse > * {
      direction: ltr;
    }

    .service-visual {
      order: -1;
    }

    .service-list {
      line-height: 1.85;
    }

    .process-track {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .process-step {
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .service-block {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
