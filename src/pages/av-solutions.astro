---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';

const avServices = [
  {
    id: 'business',
    eyebrow: 'Corporate & Business',
    title: 'Boardrooms, meeting rooms, and executive AV that people can actually use.',
    summary: 'Clean communication spaces with display, camera, audio, switching, control, and support designed together from day one.',
    visual: 'Boardroom',
    accent: 'blue',
    for: ['Corporate offices', 'Meeting rooms', 'Training rooms', 'Executive suites'],
    solves: ['Confusing remotes and cables', 'Poor microphone pickup', 'Unreliable video calls', 'Hard-to-support room systems'],
    stack: ['Teams / Zoom rooms', 'DSP audio', 'Touch-panel control', 'Wireless presentation', 'Room scheduling'],
  },
  {
    id: 'government',
    eyebrow: 'Government & Public Sector',
    title: 'Reliable AV and control rooms for serious operational environments.',
    summary: 'Systems designed around uptime, documentation, clear operation, and long-term maintainability for public and mission-focused spaces.',
    visual: 'Control Room',
    accent: 'cyan',
    for: ['Council chambers', 'Command rooms', 'Briefing rooms', 'Public facilities'],
    solves: ['Complex multi-source routing', 'Operator confusion', 'Poor visibility', 'Weak documentation'],
    stack: ['Video walls', 'Matrix switching', 'Control logic', 'PA systems', 'Redundant signal paths'],
  },
  {
    id: 'education',
    eyebrow: 'Education',
    title: 'Smart classrooms and lecture theatres built for teachers first.',
    summary: 'Teaching spaces that combine projection, display, audio, lecture capture, simple control, and remote learning support.',
    visual: 'Smart Classroom',
    accent: 'purple',
    for: ['Schools', 'Colleges', 'Universities', 'Training centres'],
    solves: ['Teachers wasting class time', 'Bad classroom audio', 'Messy source selection', 'Hard hybrid teaching'],
    stack: ['Projectors / LED displays', 'Wireless microphones', 'Lecture capture', 'Interactive display', 'Simple wall panels'],
  },
  {
    id: 'healthcare',
    eyebrow: 'Healthcare',
    title: 'Clear communication and display systems for healthcare spaces.',
    summary: 'AV for consultation, training, waiting areas, collaboration rooms, and medical communication environments where reliability matters.',
    visual: 'Clinical AV',
    accent: 'green',
    for: ['Clinics', 'Hospitals', 'Training labs', 'Waiting areas'],
    solves: ['Poor teleconsultation quality', 'Noisy rooms', 'Weak patient information display', 'Difficult staff communication'],
    stack: ['Telemedicine displays', 'Ceiling speakers', 'Wireless presentation', 'Digital signage', 'Paging integration'],
  },
  {
    id: 'entertainment',
    eyebrow: 'Entertainment & Venues',
    title: 'Immersive screens, sound, lighting, and show-control experiences.',
    summary: 'High-impact spaces for stages, auditoriums, museums, events, restaurants, and venues that need atmosphere and reliability.',
    visual: 'Immersive Venue',
    accent: 'pink',
    for: ['Auditoriums', 'Museums', 'Event venues', 'Performance spaces'],
    solves: ['Flat presentation impact', 'Weak sound coverage', 'Hard show operation', 'Unplanned signal flow'],
    stack: ['LED walls', 'Projection', 'Stage audio', 'Lighting control', 'Show presets'],
  },
  {
    id: 'hospitality',
    eyebrow: 'Hospitality & Residential',
    title: 'Premium AV, control, and automation for guest experiences.',
    summary: 'Elegant technology for hotels, cafés, restaurants, premium homes, and retail spaces where the system should feel invisible until needed.',
    visual: 'Guest Experience',
    accent: 'gold',
    for: ['Hotels', 'Restaurants', 'Retail spaces', 'Premium homes'],
    solves: ['Inconsistent guest experience', 'Manual switching', 'Poor background music zoning', 'Unreliable signage'],
    stack: ['Multi-zone audio', 'Lighting scenes', 'Digital signage', 'Control panels', 'Automation schedules'],
  },
];

const workflow = [
  { no: '01', title: 'Discovery', text: 'We map the room, user behaviour, cable paths, signal flow, network requirements, budget, and support expectation.' },
  { no: '02', title: 'System Design', text: 'We produce a practical system concept covering displays, audio, VC, control, networking, power, and future upgrade paths.' },
  { no: '03', title: 'Integration', text: 'Hardware, programming, cable management, configuration, and UI logic are implemented as one complete system.' },
  { no: '04', title: 'Commissioning', text: 'Every button, source, microphone, speaker zone, display, and user workflow is tested before handover.' },
];
---

<Layout>
  <section class="services-hero av-hero">
    <div class="services-bg-grid"></div>
    <div class="container services-hero-inner">
      <div class="services-kicker">AV Solutions</div>
      <h1>Professional audiovisual systems, engineered from design to completion.</h1>
      <p>
        We build AV spaces where the display, audio, camera, control, network, and user interface feel like one reliable system — not separate pieces fighting each other.
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-primary">Plan an AV Project</a>
        <a href="/projects" class="btn btn-secondary">View Project Studio</a>
      </div>
    </div>
  </section>

  <section class="service-command section">
    <div class="container command-grid">
      <div class="command-copy">
        <div class="section-label">Service System</div>
        <h2 class="section-title">Not just equipment. Complete room logic.</h2>
        <p class="section-subtitle">
          A professional AV system succeeds when the person using the room does not need to understand the technology behind it. That is the design standard for every AVIT Solutions project.
        </p>
      </div>
      <div class="command-panel">
        <div class="panel-row"><span>Display</span><strong>LED · Projection · Touch</strong></div>
        <div class="panel-row"><span>Audio</span><strong>DSP · Mics · Speakers</strong></div>
        <div class="panel-row"><span>Control</span><strong>Touch UI · Relay · Logic</strong></div>
        <div class="panel-row"><span>Network</span><strong>AV-over-IP · VLAN-aware</strong></div>
        <div class="panel-row"><span>Support</span><strong>Commissioning · Handover</strong></div>
      </div>
    </div>
  </section>

  <section class="service-matrix section" style="padding-top: 0;">
    <div class="container">
      <div class="matrix-head">
        <div>
          <div class="section-label">AV Environments</div>
          <h2 class="section-title">Solutions by space and purpose.</h2>
        </div>
        <p>
          Each environment has different users, risks, acoustics, source requirements, and maintenance needs. The service cards below are written like real project scopes, not generic marketing text.
        </p>
      </div>

      <div class="service-stack">
        {avServices.map((service) => (
          <article id={service.id} class={`service-system-card ${service.accent}`}>
            <div class="service-visual-block">
              <div class="visual-grid"></div>
              <div class="screen-frame">
                <span>{service.visual}</span>
                <div class="screen-lines"><i></i><i></i><i></i></div>
              </div>
              <div class="floating-chip chip-one">AV</div>
              <div class="floating-chip chip-two">CTRL</div>
              <div class="floating-chip chip-three">IP</div>
            </div>
            <div class="service-body">
              <span class="service-eyebrow">{service.eyebrow}</span>
              <h3>{service.title}</h3>
              <p>{service.summary}</p>
              <div class="scope-grid">
                <div>
                  <h4>Best for</h4>
                  <ul>{service.for.map((item) => <li>{item}</li>)}</ul>
                </div>
                <div>
                  <h4>Solves</h4>
                  <ul>{service.solves.map((item) => <li>{item}</li>)}</ul>
                </div>
                <div>
                  <h4>Typical stack</h4>
                  <ul>{service.stack.map((item) => <li>{item}</li>)}</ul>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="workflow-section section">
    <div class="container">
      <div class="matrix-head">
        <div>
          <div class="section-label">Delivery Method</div>
          <h2 class="section-title">A clean process from survey to support.</h2>
        </div>
      </div>
      <div class="workflow-grid">
        {workflow.map((step) => (
          <article class="workflow-card">
            <span>{step.no}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Have a room, hall, classroom, or venue to upgrade?"
    subtitle="Tell us what needs to be displayed, heard, controlled, recorded, or automated. We will convert it into a practical AV system plan."
    ctaText="Start an AV Project"
    ctaLink="/contact"
  />
</Layout>

<style>
  .services-hero {
    position: relative;
    min-height: 74vh;
    display: flex;
    align-items: center;
    padding: 9rem 0 5rem;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(6,8,13,0.98), rgba(6,8,13,0.74) 44%, rgba(6,8,13,0.92)),
      radial-gradient(circle at 78% 42%, rgba(79, 70, 229, 0.35), transparent 26rem),
      radial-gradient(circle at 12% 20%, rgba(0, 184, 212, 0.22), transparent 24rem),
      #07090d;
  }

  .services-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, transparent 0 52%, rgba(96, 165, 250, 0.1) 52.2% 52.5%, transparent 52.7%),
      radial-gradient(circle at 75% 46%, rgba(255,255,255,0.08), transparent 1px),
      radial-gradient(circle at 82% 58%, rgba(0,184,212,0.12), transparent 2px);
    pointer-events: none;
  }

  .services-bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size: 58px 58px;
    mask-image: radial-gradient(circle at 55% 45%, black, transparent 72%);
    opacity: 0.55;
  }

  .services-hero-inner {
    position: relative;
    z-index: 2;
    max-width: 860px;
  }

  .services-kicker {
    display: inline-flex;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(80, 217, 255, 0.28);
    background: rgba(80, 217, 255, 0.08);
    color: #69dfff;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.75rem;
    font-weight: 900;
    margin-bottom: 1.5rem;
  }

  .services-hero h1 {
    font-size: clamp(2.7rem, 7vw, 6.6rem);
    line-height: 0.94;
    letter-spacing: -0.07em;
    max-width: 930px;
    margin-bottom: 1.5rem;
  }

  .services-hero p {
    color: rgba(235, 244, 255, 0.72);
    font-size: clamp(1rem, 1.65vw, 1.28rem);
    line-height: 1.75;
    max-width: 670px;
    margin-bottom: 2rem;
  }

  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  .command-grid,
  .matrix-head {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 3rem;
    align-items: center;
  }

  .command-panel {
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 30px;
    padding: 1rem;
    background: linear-gradient(180deg, rgba(255,255,255,0.075), rgba(255,255,255,0.025));
    box-shadow: 0 30px 90px rgba(0,0,0,0.28);
  }

  .panel-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .panel-row:last-child { border-bottom: 0; }
  .panel-row span { color: rgba(226, 237, 248, 0.58); }
  .panel-row strong { color: white; text-align: right; }

  .matrix-head { margin-bottom: 2.3rem; align-items: end; }
  .matrix-head > p { color: var(--text-secondary); line-height: 1.7; max-width: 620px; }

  .service-stack { display: grid; gap: 1.25rem; }

  .service-system-card {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    min-height: 430px;
    border: 1px solid rgba(255,255,255,0.095);
    border-radius: 34px;
    overflow: hidden;
    background: linear-gradient(140deg, rgba(255,255,255,0.07), rgba(255,255,255,0.025));
    box-shadow: 0 35px 100px rgba(0,0,0,0.22);
  }

  .service-visual-block {
    position: relative;
    min-height: 100%;
    background:
      radial-gradient(circle at 50% 40%, rgba(0,184,212,0.23), transparent 15rem),
      linear-gradient(145deg, rgba(10,14,24,0.92), rgba(20,24,36,0.94));
    overflow: hidden;
  }

  .visual-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 42px 42px;
    transform: perspective(700px) rotateX(62deg) translateY(-10%);
    transform-origin: center;
    opacity: 0.48;
  }

  .screen-frame {
    position: absolute;
    inset: 22% 12%;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,0.16);
    display: grid;
    place-items: center;
    background:
      linear-gradient(135deg, rgba(255,255,255,0.08), transparent),
      radial-gradient(circle at 55% 40%, rgba(255,255,255,0.11), transparent 8rem);
    box-shadow: inset 0 0 50px rgba(255,255,255,0.05), 0 30px 70px rgba(0,0,0,0.36);
  }

  .screen-frame span {
    font-size: clamp(1.6rem, 4vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    text-align: center;
    opacity: 0.92;
  }

  .screen-lines {
    position: absolute;
    bottom: 22px;
    left: 22px;
    right: 22px;
    display: grid;
    gap: 0.5rem;
  }

  .screen-lines i {
    height: 6px;
    border-radius: 999px;
    background: rgba(255,255,255,0.12);
  }

  .screen-lines i:nth-child(1) { width: 80%; }
  .screen-lines i:nth-child(2) { width: 54%; }
  .screen-lines i:nth-child(3) { width: 66%; }

  .floating-chip {
    position: absolute;
    padding: 0.55rem 0.75rem;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.13);
    background: rgba(0,0,0,0.42);
    backdrop-filter: blur(18px);
    font-size: 0.75rem;
    font-weight: 900;
    color: white;
    box-shadow: 0 16px 50px rgba(0,0,0,0.24);
  }

  .chip-one { top: 17%; left: 12%; }
  .chip-two { top: 12%; right: 13%; }
  .chip-three { bottom: 14%; right: 18%; }

  .service-body { padding: clamp(1.5rem, 4vw, 3rem); }
  .service-eyebrow {
    display: inline-block;
    color: #69dfff;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 900;
    margin-bottom: 0.9rem;
  }

  .service-body h3 {
    font-size: clamp(1.7rem, 4vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.055em;
    max-width: 760px;
    margin-bottom: 1rem;
  }

  .service-body p { color: var(--text-secondary); line-height: 1.75; max-width: 760px; }

  .scope-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.7rem;
  }

  .scope-grid > div {
    padding: 1rem;
    border-radius: 20px;
    background: rgba(255,255,255,0.045);
    border: 1px solid rgba(255,255,255,0.06);
  }

  .scope-grid h4 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.92);
    margin-bottom: 0.8rem;
  }

  .scope-grid ul { list-style: none; display: grid; gap: 0.55rem; }
  .scope-grid li { color: rgba(226,237,248,0.68); font-size: 0.9rem; line-height: 1.35; }
  .scope-grid li::before { content: '•'; color: #69dfff; margin-right: 0.5rem; }

  .service-system-card.purple .service-visual-block { background: radial-gradient(circle at 50% 40%, rgba(168,85,247,0.32), transparent 15rem), linear-gradient(145deg, rgba(10,14,24,0.92), rgba(20,24,36,0.94)); }
  .service-system-card.green .service-visual-block { background: radial-gradient(circle at 50% 40%, rgba(34,197,94,0.25), transparent 15rem), linear-gradient(145deg, rgba(10,14,24,0.92), rgba(20,24,36,0.94)); }
  .service-system-card.pink .service-visual-block { background: radial-gradient(circle at 50% 40%, rgba(236,72,153,0.25), transparent 15rem), linear-gradient(145deg, rgba(10,14,24,0.92), rgba(20,24,36,0.94)); }
  .service-system-card.gold .service-visual-block { background: radial-gradient(circle at 50% 40%, rgba(245,158,11,0.24), transparent 15rem), linear-gradient(145deg, rgba(10,14,24,0.92), rgba(20,24,36,0.94)); }

  .workflow-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .workflow-card {
    padding: 1.35rem;
    min-height: 230px;
    border-radius: 26px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.045);
  }
  .workflow-card span { color: #69dfff; font-size: 0.8rem; font-weight: 900; letter-spacing: 0.14em; }
  .workflow-card h3 { font-size: 1.2rem; margin: 1.1rem 0 0.7rem; }
  .workflow-card p { color: var(--text-secondary); line-height: 1.65; font-size: 0.93rem; }

  @media (max-width: 960px) {
    .command-grid,
    .matrix-head,
    .service-system-card { grid-template-columns: 1fr; }
    .service-visual-block { min-height: 340px; }
    .scope-grid { grid-template-columns: 1fr; }
    .workflow-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 620px) {
    .services-hero { min-height: auto; padding: 7.5rem 0 3.5rem; }
    .services-hero h1 { font-size: clamp(2.4rem, 15vw, 4.4rem); }
    .hero-actions .btn { width: 100%; justify-content: center; }
    .service-system-card { border-radius: 24px; }
    .service-visual-block { min-height: 270px; }
    .workflow-grid { grid-template-columns: 1fr; }
    .panel-row { flex-direction: column; }
    .panel-row strong { text-align: left; }
  }
</style>
