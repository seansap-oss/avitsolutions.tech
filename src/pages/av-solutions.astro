---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout>
  <section class="section page-hero">
    <div class="container" style="text-align: center;">
      <div class="section-label">AV Solutions</div>
      <h1 class="section-title" style="font-size: clamp(2.5rem, 5vw, 3.5rem);">
        Audiovisual Integration
      </h1>
      <p class="section-subtitle" style="margin: 0 auto 0;">
        From concept to commissioning — we design, supply, install, and support AV systems for any environment.
      </p>
    </div>
  </section>

  <section id="corporate" class="section" style="padding-top: 0;">
    <div class="container">
      <div class="service-block glass" style="margin-bottom: 2rem;">
        <div class="service-grid">
          <div class="service-content">
            <span class="section-label">Corporate</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);">Enterprise-Grade AV for the Modern Workplace</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
              We design and install AV systems that empower collaboration, impress clients, and streamline operations. Every solution is engineered to integrate seamlessly with existing IT infrastructure.
            </p>
            <ul class="service-list">
              <li>Boardrooms & executive conference rooms</li>
              <li>Huddle rooms & flexible meeting spaces</li>
              <li>Auditoriums & town hall spaces</li>
              <li>Digital signage & wayfinding</li>
              <li>Unified communications (Teams, Zoom, Webex)</li>
              <li>Video walls & projection systems</li>
              <li>Wireless presentation & BYOD</li>
            </ul>
          </div>
          <div class="service-visual">
            <div class="service-placeholder" style="background: linear-gradient(135deg, #1a1d24, #0d1117);">
              <span style="font-size: 4rem; opacity: 0.3;">🏢</span>
            </div>
          </div>
        </div>
      </div>

      <div id="residential" class="service-block glass" style="margin-bottom: 2rem;">
        <div class="service-grid reverse">
          <div class="service-content">
            <span class="section-label">Residential</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);">Intelligent Homes, Effortless Living</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
              Transform your home with immersive entertainment, whole-home automation, and intuitive control. We deliver luxury experiences that disappear into the architecture.
            </p>
            <ul class="service-list">
              <li>Home theaters & media rooms</li>
              <li>Whole-home audio & multi-room music</li>
              <li>Smart lighting & motorized shading</li>
              <li>Climate & energy management</li>
              <li>Security cameras & intercom systems</li>
              <li>Voice & app-based control</li>
              <li>Custom automation scenes</li>
            </ul>
          </div>
          <div class="service-visual">
            <div class="service-placeholder" style="background: linear-gradient(135deg, #1a2430, #0d1117);">
              <span style="font-size: 4rem; opacity: 0.3;">🏠</span>
            </div>
          </div>
        </div>
      </div>

      <div id="government" class="service-block glass">
        <div class="service-grid">
          <div class="service-content">
            <span class="section-label">Government</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);">Secure, Reliable, Certified AV for Public Sector</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
              We deliver AV and communication systems that meet the highest standards of security, redundancy, and compliance. Built for mission-critical government environments.
            </p>
            <ul class="service-list">
              <li>Council chambers & legislative halls</li>
              <li>Emergency operations centers</li>
              <li>Command & control rooms</li>
              <li>Classified briefing facilities</li>
              <li>Secure video conferencing (SIPR/NIPR)</li>
              <li>Public address & emergency notification</li>
              <li>Redundant AV infrastructure</li>
            </ul>
          </div>
          <div class="service-visual">
            <div class="service-placeholder" style="background: linear-gradient(135deg, #1a1d2e, #0d1117);">
              <span style="font-size: 4rem; opacity: 0.3;">🏛️</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="section-label">Our Process</div>
      <h2 class="section-title">From Design to Completion</h2>
      <p class="section-subtitle" style="margin-bottom: 3rem;">
        A proven methodology that ensures every project is delivered on time, on budget, and beyond expectations.
      </p>

      <div class="process-track">
        <div class="process-step">
          <div class="process-number">01</div>
          <h3>Discovery & Design</h3>
          <p>We learn your goals, map requirements, and create a detailed system design and scope of work.</p>
        </div>
        <div class="process-connector"></div>
        <div class="process-step">
          <div class="process-number">02</div>
          <h3>Engineering & Procurement</h3>
          <p>We engineer the solution, source all equipment from trusted manufacturers, and pre-configure systems.</p>
        </div>
        <div class="process-connector"></div>
        <div class="process-step">
          <div class="process-number">03</div>
          <h3>Installation & Integration</h3>
          <p>Professional on-site installation with minimal disruption. Full integration with your existing IT environment.</p>
        </div>
        <div class="process-connector"></div>
        <div class="process-step">
          <div class="process-number">04</div>
          <h3>Commissioning & Support</h3>
          <p>Thorough testing, staff training, and ongoing support to ensure your system performs flawlessly.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Design Your AV System"
    subtitle="Tell us about your space and needs. We'll design a solution that fits."
    ctaText="Start Your AV Project"
    ctaLink="/contact"
  />
</Layout>

<style>
  .page-hero {
    padding-bottom: 2rem;
  }

  .service-block {
    padding: 3rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--glass-border);
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .service-grid.reverse {
    direction: rtl;
  }

  .service-grid.reverse > * {
    direction: ltr;
  }

  .service-list {
    list-style: none;
    color: var(--text-secondary);
    line-height: 2;
  }

  .service-list li {
    position: relative;
    padding-left: 1.25rem;
  }

  .service-list li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .service-visual {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .service-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-lg);
  }

  .process-track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .process-step {
    padding: 2rem;
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    transition: all var(--transition-base);
  }

  .process-step:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }

  .process-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--accent);
    opacity: 0.4;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .process-step h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .process-step p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .process-connector {
    display: none;
  }

  @media (max-width: 768px) {
    .service-block {
      padding: 2rem;
    }

    .service-grid, .service-grid.reverse {
      grid-template-columns: 1fr;
      direction: ltr;
    }

    .service-grid.reverse > * {
      direction: ltr;
    }

    .service-visual {
      order: -1;
    }

    .process-track {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
