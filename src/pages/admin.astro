---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="section page-hero">
    <div class="container" style="text-align: center;">
      <div class="admin-tabs">
        <a href="/admin" class="admin-tab active">Images</a>
        <a href="/admin/text" class="admin-tab">Text</a>
      </div>
      <div class="section-label">Admin</div>
      <h1 class="section-title" style="font-size: clamp(2rem, 4vw, 3rem);">
        Image Manager
      </h1>
      <p class="section-subtitle" style="margin: 0 auto 0;">
        Upload images from your computer (auto-resized to 1200px) or paste any URL. Changes save to your browser.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div id="loginScreen">
        <div class="login-card glass">
          <div class="login-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h2 class="login-title">Enter Password</h2>
          <p class="login-desc">This area is restricted. Enter the admin password to manage images.</p>
          <form id="loginForm" class="login-form">
            <input type="password" id="loginPassword" class="login-input" placeholder="Admin password" autocomplete="off" />
            <button type="submit" class="login-btn">Unlock</button>
            <p id="loginError" class="login-error"></p>
          </form>
        </div>
      </div>
      <div id="adminApp" style="display: none;"></div>
    </div>
  </section>
</Layout>

<script>
const STORAGE_KEY = 'avit-custom-images';
const ADMIN_PW_HASH = 'YXZpdDIwMjQ=';
const AUTH_KEY = 'avit-admin-auth';

(function init() {
  if (sessionStorage.getItem(AUTH_KEY)) {
    document.getElementById('loginScreen').style.display = 'none';
    document.getElementById('adminApp').style.display = '';
  }
  document.getElementById('loginForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var pw = document.getElementById('loginPassword').value;
    if (btoa(pw) === ADMIN_PW_HASH) {
      sessionStorage.setItem(AUTH_KEY, '1');
      document.getElementById('loginScreen').style.display = 'none';
      document.getElementById('adminApp').style.display = '';
      render();
    } else {
      document.getElementById('loginError').textContent = 'Incorrect password. Try again.';
      document.getElementById('loginPassword').value = '';
    }
  });
})();

const groups = [
  {
    name: 'AV Solutions',
    items: [
      { key: 'av-business', label: 'Business', default: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&h=600&fit=crop&q=80' },
      { key: 'av-government', label: 'Government', default: 'https://images.unsplash.com/photo-1577412647305-991150c7d163?w=800&h=600&fit=crop&q=80' },
      { key: 'av-education', label: 'Education', default: 'https://images.unsplash.com/photo-1509062522246-3755977927d7?w=800&h=600&fit=crop&q=80' },
      { key: 'av-healthcare', label: 'Healthcare', default: 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=800&h=600&fit=crop&q=80' },
      { key: 'av-entertainment', label: 'Entertainment', default: 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=800&h=600&fit=crop&q=80' },
      { key: 'av-hospitality', label: 'Hospitality', default: 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800&h=600&fit=crop&q=80' },
    ],
  },
  {
    name: 'IT Solutions',
    items: [
      { key: 'it-mobile-apps', label: 'Mobile Apps', default: 'https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?w=800&h=600&fit=crop&q=80' },
      { key: 'it-hybrid-software', label: 'Hybrid Software', default: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=800&h=600&fit=crop&q=80' },
      { key: 'it-erp', label: 'Custom ERP', default: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=600&fit=crop&q=80' },
      { key: 'it-ai-ecommerce', label: 'AI for Business', default: 'https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800&h=600&fit=crop&q=80' },
      { key: 'it-warehouse', label: 'Warehouse', default: 'https://images.unsplash.com/photo-1553413077-190dd305871c?w=800&h=600&fit=crop&q=80' },
      { key: 'it-digital-signage', label: 'Digital Signage', default: 'https://images.unsplash.com/photo-1531482615713-2afd69097998?w=800&h=600&fit=crop&q=80' },
    ],
  },
  {
    name: 'Project Case Studies',
    items: [
      { key: 'project-corporate-hq', label: 'Corporate HQ', default: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=1200&h=600&fit=crop&q=80' },
      { key: 'project-smart-home', label: 'Smart Home', default: 'https://images.pexels.com/photos/8583821/pexels-photo-8583821.jpeg?auto=compress&cs=tinysrgb&w=1200&h=600' },
      { key: 'project-gov-building', label: 'Government Chambers', default: 'https://images.unsplash.com/photo-1577412647305-991150c7d163?w=1200&h=600&fit=crop&q=80' },
    ],
  },
  {
    name: 'About Page',
    items: [
      { key: 'about-hero', label: 'Hero / Team', default: 'https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?w=800&h=500&fit=crop&q=80' },
      { key: 'cert-amx', label: 'AMX Certification', default: 'https://images.unsplash.com/photo-1558618666-fcd25c85f82e?w=400&h=300&fit=crop&q=80' },
      { key: 'cert-crestron', label: 'Crestron Certification', default: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=400&h=300&fit=crop&q=80' },
      { key: 'cert-extron', label: 'Extron Certification', default: 'https://images.unsplash.com/photo-1478737270239-2f02b77fc618?w=400&h=300&fit=crop&q=80' },
    ],
  },
];

function loadSaved() {
  try {
    return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
  } catch {
    return {};
  }
}

function saveAll(data) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
}

function getUrl(item, data) {
  return data[item.key] || item.default;
}

function render() {
  const data = loadSaved();
  const app = document.getElementById('adminApp');
  if (!app) return;

  let html = '';

  for (const group of groups) {
    html += `<div class="admin-group">
      <h2 class="admin-group-title">${group.name}</h2>
      <div class="admin-grid">`;

    for (const item of group.items) {
      const url = getUrl(item, data);
      const isCustom = item.key in data;
      html += `<div class="admin-card glass" data-key="${item.key}">
        <div class="admin-preview">
          <img src="${url}" alt="${item.label}" loading="lazy" onerror="this.style.display='none'" />
        </div>
        <div class="admin-info">
          <strong>${item.label}</strong>
          <span class="admin-key">${item.key}</span>
        </div>
        <div class="admin-input-row">
          <input type="text" class="admin-input" value="${url}" placeholder="Paste image URL..." />
          <label class="admin-btn admin-btn-upload">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            Upload
            <input type="file" accept="image/*" class="admin-file-input" />
          </label>
        </div>
        <div class="admin-actions">
          <button class="admin-btn admin-btn-save">Save</button>
          <span class="admin-badge ${isCustom ? '' : 'admin-badge-default'}">${isCustom ? 'Custom' : 'Default'}</span>
        </div>
      </div>`;
    }

    html += `</div></div>`;
  }

  html += `<div class="admin-footer">
    <button class="admin-btn admin-btn-reset-all" id="resetAll">Reset All to Defaults</button>
    <p class="admin-note">Changes are stored in your browser (localStorage). Persist until cleared.</p>
  </div>`;

  app.innerHTML = html;

  for (const card of document.querySelectorAll('.admin-card')) {
    const key = card.dataset.key;
    const input = card.querySelector('.admin-input');
    const saveBtn = card.querySelector('.admin-btn-save');
    const badge = card.querySelector('.admin-badge');
    const fileInput = card.querySelector('.admin-file-input');

    function setCustom(url) {
      const data = loadSaved();
      data[key] = url;
      saveAll(data);
      card.querySelector('.admin-preview img').src = url;
      card.querySelector('.admin-preview img').style.display = '';
      badge.textContent = 'Custom';
      badge.className = 'admin-badge';
    }

    saveBtn.addEventListener('click', () => {
      const url = input.value.trim();
      if (!url) return;
      setCustom(url);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        saveBtn.click();
      }
    });

    fileInput.addEventListener('change', () => {
      const file = fileInput.files[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) {
        alert('Please select an image file.');
        return;
      }
      if (file.size > 20 * 1024 * 1024) {
        alert('Image is too large. Max 20MB.');
        return;
      }
      const reader = new FileReader();
      reader.onload = function (e) {
        const img = new Image();
        img.onload = function () {
          const MAX_W = 1200;
          let w = img.width;
          let h = img.height;
          if (w > MAX_W) {
            h = Math.round(h * MAX_W / w);
            w = MAX_W;
          }
          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, w, h);
          const resized = canvas.toDataURL('image/jpeg', 0.85);
          input.value = resized;
          setCustom(resized);
          fileInput.value = '';
        };
        img.onerror = function () {
          alert('Failed to process image. Try another file.');
        };
        img.src = e.target.result;
      };
      reader.onerror = function () {
        alert('Failed to read file. Try again.');
      };
      reader.readAsDataURL(file);
    });
  }

  const resetAllBtn = document.getElementById('resetAll');
  if (resetAllBtn) {
    resetAllBtn.addEventListener('click', () => {
      if (confirm('Reset all images to defaults?')) {
        localStorage.removeItem(STORAGE_KEY);
        render();
      }
    });
  }
}

if (sessionStorage.getItem(AUTH_KEY)) { render(); }
</script>

<style>
  .page-hero {
    padding-bottom: 2rem;
  }

  .admin-tabs {
    display: flex;
    gap: 0.25rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .admin-tab {
    padding: 0.4rem 1.25rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    transition: all var(--transition-fast);
  }

  .admin-tab:hover {
    color: var(--text-primary);
    border-color: var(--accent-dim);
  }

  .admin-tab.active {
    background: var(--accent);
    color: var(--bg-primary);
    border-color: var(--accent);
  }

  #loginScreen {
    display: flex;
    justify-content: center;
    padding: 2rem 0 4rem;
  }

  .login-card {
    max-width: 420px;
    width: 100%;
    padding: 2.5rem 2rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--glass-border);
    text-align: center;
  }

  .login-icon {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
    color: var(--accent);
    opacity: 0.7;
  }

  .login-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .login-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .login-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: 1rem;
    text-align: center;
    box-sizing: border-box;
  }

  .login-input:focus {
    outline: none;
    border-color: var(--accent-dim);
  }

  .login-btn {
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--accent);
    color: var(--bg-primary);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .login-btn:hover {
    opacity: 0.85;
  }

  .login-error {
    font-size: 0.85rem;
    color: #ff4444;
    margin: 0;
    min-height: 1.2em;
  }

  .admin-group {
    margin-bottom: 2.5rem;
  }

  .admin-group-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .admin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }

  .admin-card {
    padding: 1rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--glass-border);
  }

  .admin-preview {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 0.75rem;
    background: var(--bg-tertiary);
  }

  .admin-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .admin-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    font-size: 0.9rem;
  }

  .admin-key {
    font-size: 0.7rem;
    color: var(--text-tertiary);
    font-family: monospace;
  }

  .admin-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: 0.8rem;
    font-family: monospace;
    min-width: 0;
  }

  .admin-input:focus {
    outline: none;
    border-color: var(--accent-dim);
  }

  .admin-input-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    align-items: stretch;
  }

  .admin-btn-upload {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .admin-btn-upload:hover {
    border-color: var(--accent-dim);
    color: var(--accent);
  }

  .admin-file-input {
    display: none;
  }

  .admin-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .admin-btn {
    padding: 0.4rem 1rem;
    border-radius: var(--radius-sm);
    border: none;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .admin-btn-save {
    background: var(--accent);
    color: var(--bg-primary);
  }

  .admin-btn-save:hover {
    opacity: 0.85;
  }

  .admin-btn-reset-all {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
  }

  .admin-btn-reset-all:hover {
    border-color: #ff4444;
    color: #ff4444;
  }

  .admin-badge {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(0, 229, 255, 0.15);
    color: var(--accent);
    margin-left: auto;
  }

  .admin-badge-default {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-tertiary);
  }

  .admin-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 2rem 0 4rem;
  }

  .admin-note {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  @media (max-width: 480px) {
    .admin-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
