---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    number: '01',
    title: 'Audiovisual',
    href: '/av-solutions',
    description: 'Design, supply, installation and control programming for meeting rooms, classrooms, venues and integrated spaces.',
  },
  {
    number: '02',
    title: 'IT & Networks',
    href: '/it-solutions',
    description: 'Network planning, infrastructure, workplace technology and AV-over-IP built for reliable performance.',
  },
  {
    number: '03',
    title: 'Software',
    href: '/it-solutions#hybrid-software',
    description: 'Websites, apps, learning platforms, dashboards, ERP systems and custom workflow automation.',
  },
];

const selectedWork = [
  {
    eyebrow: 'Audiovisual',
    title: 'Connected meeting spaces',
    description: 'Modern AV experiences for education and business.',
    image: '/images/services/service-av-business.webp',
    href: '/av-solutions#business',
  },
  {
    eyebrow: 'Software',
    title: 'Digital platforms',
    description: 'Custom web applications, dashboards and business systems.',
    image: '/service-media/hybrid-software.webp',
    href: '/projects/syncstation',
  },
];
---

<Layout
  title="AviT Solutions — Audiovisual, IT & Software"
  description="AviT Solutions designs connected audiovisual spaces, IT infrastructure and custom software from planning to delivery."
  canonical="/"
  image="/service-media/boardroom.webp"
>
  <section class="editorial-hero">
    <div class="editorial-shell hero-grid">
      <div class="hero-copy">
        <h1>Spaces connected.<br />Software made simple<span class="red-dot">.</span></h1>
        <p>Audiovisual, IT and custom software.<br />From planning to delivery.</p>
        <div class="hero-actions">
          <a href="/contact" class="editorial-button">Start a conversation <span>→</span></a>
          <a href="/projects" class="editorial-link">View our work</a>
        </div>
      </div>
    </div>
  </section>

  <section class="selected-work section-tight">
    <div class="editorial-shell">
      <div class="section-head">
        <h2>Selected work</h2>
        <a href="/projects">View all work <span>→</span></a>
      </div>
      <div class="work-grid">
        {selectedWork.map((project) => (
          <a class="work-card" href={project.href}>
            <div class="work-image">
              <img src={project.image} alt="" loading="eager" />
            </div>
            <div class="work-meta">
              <span>{project.eyebrow}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="service-index section-tight">
    <div class="editorial-shell">
      <div class="section-rule-title">Our services</div>
      <div class="service-list">
        {services.map((service) => (
          <a class="service-row" href={service.href}>
            <span class="service-number">{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <span class="service-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="about-strip section-tight">
    <div class="editorial-shell about-grid">
      <div>
        <div class="section-rule-title">About</div>
        <h2>Australian experience<span class="red-dot">.</span><br />Based in India<span class="red-dot">.</span></h2>
      </div>
      <p>Built on 15+ years of professional experience across education, government, corporate environments, audiovisual systems, networks and user-focused technology.</p>
    </div>
  </section>
</Layout>

<style>
  .editorial-hero {
    min-height: 350px;
    display: flex;
    align-items: center;
    padding: clamp(2.5rem, 6vw, 6rem) 0 clamp(3rem, 6vw, 5.5rem);
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.32fr); }
  .hero-copy { grid-column: 1; max-width: 920px; }
  .hero-copy h1 {
    font-family: 'Inter Tight', 'Inter', Arial, sans-serif;
    font-size: clamp(3.15rem, 6.25vw, 6.8rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.065em;
    color: var(--ink);
    max-width: 12ch;
    text-wrap: balance;
  }
  .red-dot { color: var(--red); }
  .hero-copy > p {
    margin-top: 1.45rem;
    color: var(--muted);
    font-size: clamp(0.98rem, 1.25vw, 1.15rem);
    line-height: 1.38;
  }
  .hero-actions {
    margin-top: 1.55rem;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .editorial-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.4rem;
    min-width: 190px;
    padding: 0.85rem 1.2rem;
    border-radius: 999px;
    background: var(--red);
    color: white;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .editorial-button:hover { color: white; opacity: 0.9; }
  .editorial-link {
    color: var(--ink);
    font-size: 0.8rem;
    text-decoration: none;
    padding-bottom: 0.18rem;
    border-bottom: 1px solid var(--ink);
  }

  .section-tight { padding: 1rem 0 2.25rem; }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin-bottom: 0.7rem;
  }
  .section-head h2,
  .section-rule-title {
    font-size: 0.82rem;
    font-weight: 550;
    color: var(--ink);
  }
  .section-head a {
    color: var(--ink);
    font-size: 0.72rem;
    text-decoration: none;
  }
  .section-head a span { margin-left: 0.55rem; }

  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .work-card { color: var(--ink); text-decoration: none; }
  .work-image {
    aspect-ratio: 1.58 / 1;
    overflow: hidden;
    background: #e7e3db;
  }
  .work-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms cubic-bezier(.2,.8,.2,1);
  }
  .work-card:hover .work-image img { transform: scale(1.025); }
  .work-meta { padding-top: 0.65rem; }
  .work-meta > span {
    display: none;
    color: var(--red);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .work-meta h3 {
    font-family: 'Inter Tight', 'Inter', Arial, sans-serif;
    font-size: 1.02rem;
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 600;
  }
  .work-meta p { margin-top: 0.2rem; color: var(--muted); font-size: 0.77rem; line-height: 1.35; }

  .service-index { padding-top: 0.4rem; }
  .section-rule-title { padding-bottom: 0.7rem; border-bottom: 1px solid var(--line); }
  .service-row {
    display: grid;
    grid-template-columns: 48px 220px 1fr 28px;
    gap: 0.6rem;
    align-items: center;
    min-height: 66px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .service-number { color: var(--muted); font-size: 0.72rem; }
  .service-row h3 {
    font-family: 'Inter Tight', 'Inter', Arial, sans-serif;
    font-size: 1.15rem;
    letter-spacing: -0.025em;
    font-weight: 600;
  }
  .service-row p { color: var(--muted); font-size: 0.74rem; line-height: 1.35; }
  .service-arrow { text-align: right; font-size: 1.1rem; transition: transform 180ms ease; }
  .service-row:hover .service-arrow { transform: translateX(4px); }
  .service-row:hover h3 { color: var(--red); }

  .about-strip { padding-top: 0.3rem; padding-bottom: 2.8rem; }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(240px, 0.65fr);
    gap: 4rem;
    align-items: end;
  }
  .about-grid .section-rule-title { margin-bottom: 1rem; }
  .about-grid h2 {
    font-family: 'Inter Tight', 'Inter', Arial, sans-serif;
    font-size: clamp(2rem, 3.1vw, 3.55rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    font-weight: 500;
  }
  .about-grid > p { color: var(--muted); font-size: 0.84rem; line-height: 1.45; max-width: 26rem; }

  @media (max-width: 760px) {
    .editorial-hero { min-height: 0; padding: 1.8rem 0 2.8rem; }
    .hero-grid { display: block; }
    .hero-copy h1 { font-size: clamp(3rem, 15.3vw, 4.5rem); max-width: 7.8ch; line-height: 0.91; }
    .hero-copy > p { margin-top: 1rem; font-size: 0.93rem; }
    .hero-actions { margin-top: 1rem; align-items: flex-start; flex-direction: column; gap: 0.65rem; }
    .editorial-button { min-width: 0; width: auto; }
    .section-tight { padding: 0.6rem 0 2rem; }
    .section-head { margin-bottom: 0.55rem; }
    .section-head a { display: none; }
    .work-grid { grid-template-columns: 1fr; }
    .work-card:nth-child(2) { display: none; }
    .work-image { aspect-ratio: 1.46 / 1; }
    .work-meta h3 { font-size: 0.96rem; }
    .service-row { grid-template-columns: 28px 1fr 20px; min-height: 56px; }
    .service-row p { display: none; }
    .service-row h3 { font-size: 1.02rem; }
    .about-grid { grid-template-columns: 1fr; gap: 1rem; }
    .about-grid h2 { font-size: 2rem; max-width: 13ch; }
    .about-grid > p { font-size: 0.78rem; max-width: 22rem; }
  }
</style>
