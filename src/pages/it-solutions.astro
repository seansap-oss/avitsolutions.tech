---
import Layout from '../layouts/Layout.astro';
import ImageCard from '../components/ImageCard.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout>
  <section class="section page-hero">
    <div class="container" style="text-align: center;">
      <div class="section-label">IT Solutions</div>
      <h1 class="section-title" style="font-size: clamp(2.5rem, 5vw, 3.5rem);" data-text-key="it-page-title">
        IT & Software Solutions
      </h1>
      <p class="section-subtitle" style="margin: 0 auto 0;" data-text-key="it-page-subtitle">
        Custom software, AI, and automation solutions built for modern business needs.
      </p>
    </div>
  </section>

  <section id="mobile-apps" class="section" style="padding-top: 0;">
    <div class="container">
      <div class="service-block glass" style="margin-bottom: 2rem;">
        <div class="service-grid">
          <div class="service-content">
            <span class="section-label">Mobile Apps</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);" data-text-key="it-mobile-title">Android & iOS App Development</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;" data-text-key="it-mobile-text">
              From concept to App Store, we design and develop mobile applications that deliver exceptional user experiences on iOS and Android.
            </p>
            <ul class="service-list">
              <li>iOS (Swift) & Android (Kotlin) native apps</li>
              <li>Cross-platform (React Native, Flutter)</li>
              <li>UI/UX design & prototyping</li>
              <li>Push notifications & real-time features</li>
              <li>Payment gateway integration</li>
              <li>Location-based services & mapping</li>
              <li>App Store optimization & submission</li>
            </ul>
          </div>
          <div class="service-visual">
            <ImageCard
              key="it-mobile-apps"
              src="https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?w=800&h=600&fit=crop&q=80"
              alt="Mobile app development — Android and iOS interfaces on modern smartphones"
              caption="Android & iOS Development"
            />
          </div>
        </div>
      </div>

      <div id="hybrid-software" class="service-block glass" style="margin-bottom: 2rem;">
        <div class="service-grid reverse">
          <div class="service-content">
            <span class="section-label">Hybrid Software</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);" data-text-key="it-hybrid-title">Hybrid Software and App</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;" data-text-key="it-hybrid-text">
              One codebase, every platform. We build hybrid applications that run natively on iOS, Android, and the web — reducing development time and cost while maximizing reach.
            </p>
            <ul class="service-list">
              <li>React Native & Flutter development</li>
              <li>PWA (Progressive Web Apps)</li>
              <li>Shared business logic across platforms</li>
              <li>Native module integration when needed</li>
              <li>Offline-first architecture</li>
              <li>Cross-platform UI/UX design</li>
              <li>CI/CD for multi-platform deployment</li>
            </ul>
          </div>
          <div class="service-visual">
            <ImageCard
              key="it-hybrid-software"
              src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=800&h=600&fit=crop&q=80"
              alt="Cross-platform hybrid software development — code on multiple devices"
              caption="React Native & Flutter"
            />
          </div>
        </div>
      </div>

      <div id="erp" class="service-block glass" style="margin-bottom: 2rem;">
        <div class="service-grid">
          <div class="service-content">
            <span class="section-label">ERP</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);" data-text-key="it-erp-title">Custom Business ERP Development</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;" data-text-key="it-erp-text">
              Off-the-shelf ERP never fits perfectly. We build custom enterprise resource planning systems that match your exact workflows, integrate with your existing tools, and scale with your growth.
            </p>
            <ul class="service-list">
              <li>Finance & accounting modules</li>
              <li>Inventory & supply chain management</li>
              <li>HR & payroll systems</li>
              <li>Purchase order & procurement workflows</li>
              <li>Real-time reporting & dashboards</li>
              <li>Multi-location & multi-currency support</li>
              <li>API integration with existing systems</li>
            </ul>
          </div>
          <div class="service-visual">
            <ImageCard
              key="it-erp"
              src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=600&fit=crop&q=80"
              alt="Enterprise ERP dashboard with analytics and reporting on screen"
              caption="Custom ERP Systems"
            />
          </div>
        </div>
      </div>

      <div id="ai-ecommerce" class="service-block glass" style="margin-bottom: 2rem;">
        <div class="service-grid reverse">
          <div class="service-content">
            <span class="section-label">AI Solutions</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);" data-text-key="it-ai-title">AI for Ecommerce and Businesses</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;" data-text-key="it-ai-text">
              Leverage artificial intelligence to automate decisions, personalise customer experiences, and unlock insights from your data. From recommendation engines to predictive analytics.
            </p>
            <ul class="service-list">
              <li>Product recommendation engines</li>
              <li>Dynamic pricing algorithms</li>
              <li>Customer behaviour prediction</li>
              <li>Chatbots & virtual assistants</li>
              <li>Fraud detection & prevention</li>
              <li>Inventory demand forecasting</li>
              <li>Natural language processing (NLP)</li>
            </ul>
          </div>
          <div class="service-visual">
            <ImageCard
              key="it-ai-ecommerce"
              src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800&h=600&fit=crop&q=80"
              alt="Artificial intelligence visualization — neural networks and data analytics"
              caption="AI & Machine Learning"
            />
          </div>
        </div>
      </div>

      <div id="warehouse" class="service-block glass" style="margin-bottom: 2rem;">
        <div class="service-grid">
          <div class="service-content">
            <span class="section-label">Warehouse</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);" data-text-key="it-warehouse-title">Warehouse Automation</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;" data-text-key="it-warehouse-text">
              Automate warehouse operations with intelligent software that optimises picking, packing, and shipping. Reduce errors, cut costs, and scale without adding headcount.
            </p>
            <ul class="service-list">
              <li>Warehouse Management Systems (WMS)</li>
              <li>Barcode & RFID scanning solutions</li>
              <li>Inventory tracking & cycle counting</li>
              <li>Order management & fulfilment</li>
              <li>Pick path optimisation</li>
              <li>Integration with shipping providers</li>
              <li>Real-time stock visibility</li>
            </ul>
          </div>
          <div class="service-visual">
            <ImageCard
              key="it-warehouse"
              src="https://images.unsplash.com/photo-1553413077-190dd305871c?w=800&h=600&fit=crop&q=80"
              alt="Warehouse automation — automated picking, barcode scanning, and inventory management"
              caption="Warehouse Automation"
            />
          </div>
        </div>
      </div>

      <div id="digital-signage" class="service-block glass">
        <div class="service-grid reverse">
          <div class="service-content">
            <span class="section-label">Digital Signage</span>
            <h2 class="section-title" style="font-size: clamp(1.8rem, 3vw, 2.2rem);" data-text-key="it-digital-title">Digital Signage with Custom Interface</h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;" data-text-key="it-digital-text">
              Powerful digital signage platforms with custom content management interfaces. Control what displays, when, and where — from a single screen to thousands.
            </p>
            <ul class="service-list">
              <li>Custom CMS for content management</li>
              <li>Real-time content scheduling</li>
              <li>Multi-zone & template layouts</li>
              <li>Weather, news & social media feeds</li>
              <li>Interactive touchscreen displays</li>
              <li>Centralised fleet management</li>
              <li>Analytics & viewer engagement tracking</li>
            </ul>
          </div>
          <div class="service-visual">
            <ImageCard
              key="it-digital-signage"
              src="https://images.unsplash.com/photo-1531482615713-2afd69097998?w=800&h=600&fit=crop&q=80"
              alt="Digital signage displays in a modern commercial environment"
              caption="Digital Signage Solutions"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="section-label">Our Stack</div>
      <h2 class="section-title">Technologies We Use</h2>
      <p class="section-subtitle" style="margin-bottom: 3rem;">
        Modern tools and frameworks for reliable, scalable software delivery.
      </p>
      <div class="stack-grid">
        <div class="stack-item glass">
          <span class="stack-icon">⚛️</span>
          <span class="stack-name">React / Next.js</span>
        </div>
        <div class="stack-item glass">
          <span class="stack-icon">🟦</span>
          <span class="stack-name">Node.js</span>
        </div>
        <div class="stack-item glass">
          <span class="stack-icon">🐍</span>
          <span class="stack-name">Python / Django</span>
        </div>
        <div class="stack-item glass">
          <span class="stack-icon">🍎</span>
          <span class="stack-name">Swift / iOS</span>
        </div>
        <div class="stack-item glass">
          <span class="stack-icon">🤖</span>
          <span class="stack-name">Kotlin / Android</span>
        </div>
        <div class="stack-item glass">
          <span class="stack-icon">⚡</span>
          <span class="stack-name">Flutter</span>
        </div>
        <div class="stack-item glass">
          <span class="stack-icon">🗄️</span>
          <span class="stack-name">PostgreSQL / MongoDB</span>
        </div>
        <div class="stack-item glass">
          <span class="stack-icon">☁️</span>
          <span class="stack-name">AWS / Azure</span>
        </div>
        <div class="stack-item glass">
          <span class="stack-icon">🔷</span>
          <span class="stack-name">TypeScript</span>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Need Custom Software?"
    subtitle="Tell us about your idea. We'll build it from the ground up."
    ctaText="Discuss Your Project"
    ctaLink="/contact"
  />
</Layout>

<style>
  .page-hero {
    padding-bottom: 2rem;
  }

  .service-block {
    padding: 3rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--glass-border);
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .service-grid.reverse {
    direction: rtl;
  }

  .service-grid.reverse > * {
    direction: ltr;
  }

  .service-list {
    list-style: none;
    color: var(--text-secondary);
    line-height: 2;
  }

  .service-list li {
    position: relative;
    padding-left: 1.25rem;
  }

  .service-list li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .service-visual {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .service-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-lg);
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
  }

  .stack-item {
    padding: 1.5rem 1rem;
    border-radius: var(--radius-md);
    text-align: center;
    border: 1px solid var(--glass-border);
    transition: all var(--transition-base);
  }

  .stack-item:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }

  .stack-icon {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .stack-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .service-block {
      padding: 2rem 1.5rem;
    }

    .service-grid, .service-grid.reverse {
      grid-template-columns: 1fr;
      direction: ltr;
      gap: 1.5rem;
    }

    .service-grid.reverse > * {
      direction: ltr;
    }

    .service-visual {
      order: -1;
    }

    .stack-grid {
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 0.75rem;
    }

    .stack-item {
      padding: 1.25rem 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .service-block {
      padding: 1.5rem 1.25rem;
    }
    .stack-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
