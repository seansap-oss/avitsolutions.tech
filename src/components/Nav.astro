        </a>
        <div class="nav-dropdown-menu">
          <a href="/projects#software" class="nav-dropdown-item">Software</a>
          <a href="/projects#mobile-apps" class="nav-dropdown-item">Mobile App</a>
          <a href="/projects#corporate" class="nav-dropdown-item">Corporate</a>
