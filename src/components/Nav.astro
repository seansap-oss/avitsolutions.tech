---
import BrandWordmark from './BrandWordmark.astro';

const avItems = [
  ['System design & integration', '/av-solutions'],
  ['Meeting rooms & boardrooms', '/av-solutions#business'],
  ['Classrooms & lecture theatres', '/av-solutions#education'],
  ['Government environments', '/av-solutions#government'],
  ['Healthcare', '/av-solutions#healthcare'],
  ['Hospitality', '/av-solutions#hospitality'],
  ['Entertainment & venues', '/av-solutions#entertainment'],
  ['Crestron, AMX & Extron programming', '/av-solutions#business'],
  ['Touch-panel UI / UX', '/av-solutions#business'],
  ['DSP, conferencing & AV-over-IP', '/av-solutions#business'],
];

const itItems = [
  ['Network planning & infrastructure', '/it-solutions'],
  ['Switching, routing & Wi-Fi', '/it-solutions'],
  ['AV network integration', '/it-solutions'],
  ['Workplace technology', '/it-solutions'],
  ['Infrastructure troubleshooting', '/it-solutions'],
  ['Documentation & support', '/it-solutions'],
];

const softwareItems = [
  ['Websites & web applications', '/it-solutions#hybrid-software'],
  ['Android & iOS apps', '/it-solutions#mobile-apps'],
  ['Business software & ERP', '/it-solutions#erp'],
  ['Learning platforms (LMS)', '/it-solutions#hybrid-software'],
  ['Dashboards & admin portals', '/it-solutions#hybrid-software'],
  ['Workflow automation', '/it-solutions#warehouse'],
  ['AI tools for business', '/it-solutions#ai-ecommerce'],
  ['Digital signage interfaces', '/it-solutions#digital-signage'],
];
---
<header class="editorial-nav" id="siteHeader">
  <div class="editorial-shell nav-row">
    <a class="brand-link" href="/" aria-label="AviT Solutions home">
      <BrandWordmark />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <button class="nav-text-button" id="servicesToggle" type="button" aria-expanded="false" aria-controls="servicesPanel">Services</button>
      <a href="/projects">Projects</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>

    <button class="menu-button" id="menuButton" type="button" aria-expanded="false" aria-controls="mobileMenu" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="services-panel" id="servicesPanel" hidden>
    <div class="editorial-shell services-panel-inner">
      <div class="services-panel-heading">
        <span>Services</span>
        <p>Connected spaces, reliable infrastructure and software designed around real work.</p>
      </div>
      <div class="service-column">
        <a class="service-column-title" href="/av-solutions">Audiovisual <span>→</span></a>
        {avItems.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
      <div class="service-column">
        <a class="service-column-title" href="/it-solutions">IT &amp; Networks <span>→</span></a>
        {itItems.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
      <div class="service-column">
        <a class="service-column-title" href="/it-solutions#hybrid-software">Software <span>→</span></a>
        {softwareItems.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenu" hidden>
    <div class="mobile-menu-bar">
      <BrandWordmark />
      <button type="button" id="menuClose" class="menu-close" aria-label="Close menu">×</button>
    </div>
    <div class="mobile-menu-grid">
      <nav class="mobile-primary" aria-label="Mobile primary navigation">
        <a href="/av-solutions" class="mobile-primary-active">Services <span>›</span></a>
        <a href="/projects">Projects</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
      <div class="mobile-service-detail">
        <section>
          <a class="mobile-service-title" href="/av-solutions">Audiovisual</a>
          {avItems.map(([label, href]) => <a href={href}>{label}</a>)}
        </section>
        <section>
          <a class="mobile-service-title" href="/it-solutions">IT &amp; Networks</a>
          {itItems.map(([label, href]) => <a href={href}>{label}</a>)}
        </section>
        <section>
          <a class="mobile-service-title" href="/it-solutions#hybrid-software">Software</a>
          {softwareItems.map(([label, href]) => <a href={href}>{label}</a>)}
        </section>
      </div>
    </div>
  </div>
</header>

<script>
  const servicesToggle = document.getElementById('servicesToggle');
  const servicesPanel = document.getElementById('servicesPanel');
  const menuButton = document.getElementById('menuButton');
  const mobileMenu = document.getElementById('mobileMenu');
  const menuClose = document.getElementById('menuClose');

  function closeServices() {
    if (!servicesToggle || !servicesPanel) return;
    servicesPanel.hidden = true;
    servicesToggle.setAttribute('aria-expanded', 'false');
  }

  servicesToggle?.addEventListener('click', () => {
    if (!servicesPanel) return;
    const willOpen = servicesPanel.hidden;
    servicesPanel.hidden = !willOpen;
    servicesToggle.setAttribute('aria-expanded', String(willOpen));
  });

  function setMobileMenu(open) {
    if (!mobileMenu || !menuButton) return;
    mobileMenu.hidden = !open;
    menuButton.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
  }

  menuButton?.addEventListener('click', () => setMobileMenu(true));
  menuClose?.addEventListener('click', () => setMobileMenu(false));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeServices();
      setMobileMenu(false);
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (servicesPanel && servicesToggle && !servicesPanel.hidden && !servicesPanel.contains(target) && !servicesToggle.contains(target)) {
      closeServices();
    }
  });
</script>

<style>
  .editorial-nav {
    position: relative;
    z-index: 100;
    background: var(--paper);
    color: var(--ink);
  }
  .nav-row {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .brand-link {
    color: var(--ink);
    font-size: 1.25rem;
    text-decoration: none;
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 2.35rem;
  }
  .desktop-nav a,
  .nav-text-button {
    appearance: none;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.94rem;
    cursor: pointer;
    text-decoration: none;
  }
  .desktop-nav a:hover,
  .nav-text-button:hover { color: var(--red); }
  .menu-button { display: none; }

  .services-panel {
    position: absolute;
    inset: 88px 0 auto;
    background: rgba(246, 244, 239, 0.985);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 24px 60px rgba(20, 18, 16, 0.08);
  }
  .services-panel-inner {
    display: grid;
    grid-template-columns: 1.2fr repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 5rem);
    padding-top: 2.4rem;
    padding-bottom: 2.8rem;
  }
  .services-panel-heading > span {
    font-size: 0.76rem;
    color: var(--red);
    font-weight: 700;
  }
  .services-panel-heading p {
    max-width: 22rem;
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .service-column {
    display: flex;
    flex-direction: column;
    gap: 0.48rem;
  }
  .service-column a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.82rem;
    line-height: 1.35;
  }
  .service-column a:hover { color: var(--red); }
  .service-column .service-column-title {
    display: flex;
    justify-content: space-between;
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 650;
    margin-bottom: 0.35rem;
  }

  .mobile-menu { display: none; }

  @media (max-width: 760px) {
    .nav-row { min-height: 72px; }
    .brand-link { font-size: 1rem; }
    .desktop-nav { display: none; }
    .menu-button {
      width: 42px;
      height: 42px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 4px;
      border: 0;
      background: transparent;
      cursor: pointer;
    }
    .menu-button span {
      width: 18px;
      height: 1.5px;
      background: var(--ink);
    }
    .services-panel { display: none; }
    .mobile-menu {
      position: fixed;
      inset: 0;
      z-index: 2000;
      display: block;
      overflow-y: auto;
      background: var(--paper);
      color: var(--ink);
    }
    .mobile-menu[hidden] { display: none; }
    .mobile-menu-bar {
      min-height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.15rem;
      border-bottom: 1px solid var(--line);
    }
    .menu-close {
      border: 0;
      background: transparent;
      font-size: 1.6rem;
      line-height: 1;
      cursor: pointer;
    }
    .mobile-menu-grid {
      display: grid;
      grid-template-columns: 0.84fr 1.7fr;
      min-height: calc(100dvh - 72px);
    }
    .mobile-primary {
      display: flex;
      flex-direction: column;
      padding: 1rem 0.8rem;
      border-right: 1px solid var(--line);
      gap: 0.55rem;
    }
    .mobile-primary a,
    .mobile-primary button {
      padding: 0.45rem 0;
      color: var(--ink);
      background: transparent;
      border: 0;
      text-align: left;
      font: inherit;
      font-size: 0.82rem;
      text-decoration: none;
    }
    .mobile-primary .mobile-primary-active {
      display: flex;
      justify-content: space-between;
      color: var(--red);
      font-weight: 650;
    }
    .mobile-service-detail {
      padding: 1rem 1.05rem 2rem;
    }
    .mobile-service-detail section {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      margin-bottom: 1rem;
    }
    .mobile-service-detail a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.72rem;
      line-height: 1.35;
    }
    .mobile-service-detail .mobile-service-title {
      color: var(--ink);
      font-size: 0.82rem;
      font-weight: 650;
      margin-bottom: 0.18rem;
    }
  }
</style>
