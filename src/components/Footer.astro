---
import BrandWordmark from './BrandWordmark.astro';
---
<footer class="editorial-footer">
  <div class="editorial-shell footer-top">
    <div>
      <p class="footer-kicker">Let’s make it work<span class="red-dot">.</span></p>
      <BrandWordmark class="footer-wordmark" />
    </div>
    <div class="footer-contact">
      <a href="mailto:info@avitsolutions.tech">info@avitsolutions.tech</a>
      <a href="mailto:support@avitsolutions.tech">support@avitsolutions.tech</a>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/av-solutions">AV Solutions</a>
      <a href="/it-solutions">IT Solutions</a>
      <a href="/it-solutions#hybrid-software">Software</a>
      <a href="/projects">Projects</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>
  <div class="editorial-shell footer-bottom">
    <p>© 2026 AviT Solutions. All rights reserved.</p>
    <p>Audiovisual • IT • Software</p>
  </div>
</footer>

<style>
  .editorial-footer {
    background: var(--paper);
    color: var(--ink);
    padding: 0 0 1.5rem;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.15fr 0.8fr 1fr;
    gap: 2rem;
    align-items: end;
    padding-top: 1.3rem;
    border-top: 1px solid var(--line);
  }
  .footer-kicker {
    font-family: 'Inter Tight', 'Inter', Arial, sans-serif;
    font-size: clamp(1.55rem, 2.5vw, 2.45rem);
    line-height: 1;
    letter-spacing: -0.055em;
    margin-bottom: 1rem;
  }
  .red-dot { color: var(--red); }
  .footer-wordmark { font-size: 0.8rem; color: var(--muted); }
  .footer-contact,
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.15rem;
  }
  .footer-contact a,
  .footer-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.72rem;
  }
  .footer-contact a:hover,
  .footer-links a:hover { color: var(--red); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    margin-top: 1.2rem;
    border-top: 1px solid var(--line-soft);
    color: var(--muted);
    font-size: 0.68rem;
  }

  @media (max-width: 760px) {
    .footer-top { grid-template-columns: 1fr; align-items: start; }
    .footer-bottom { flex-direction: column; }
  }
</style>
