---
const { title, subtitle, ctaText, ctaLink } = Astro.props;
---

<section class="cta-section">
  <div class="container">
    <div class="cta-inner glass">
      <div class="cta-glow"></div>
      <h2 class="cta-title">{title}</h2>
      <p class="cta-subtitle">{subtitle}</p>
      <a href={ctaLink} class="btn btn-primary cta-btn">{ctaText}</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 4rem 0;
  }

  .cta-inner {
    position: relative;
    padding: 4rem 3rem;
    border-radius: var(--radius-xl);
    text-align: center;
    border: 1px solid var(--glass-border);
    overflow: hidden;
  }

  .cta-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-title {
    position: relative;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .cta-subtitle {
    position: relative;
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 500px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .cta-btn {
    position: relative;
    font-size: 1.05rem;
    padding: 1rem 2.5rem;
  }

  @media (max-width: 768px) {
    .cta-section {
      padding: 2.5rem 0;
    }
    .cta-inner {
      padding: 2.5rem 1.5rem;
    }
    .cta-glow {
      width: 280px;
      height: 280px;
    }
  }

  @media (max-width: 480px) {
    .cta-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
