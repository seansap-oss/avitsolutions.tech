---
---

<div class="avit-progress" aria-hidden="true"><span></span></div>
<div class="avit-cursor-aura" aria-hidden="true"></div>
<div class="avit-noise-layer" aria-hidden="true"></div>
<div class="avit-scanline-layer" aria-hidden="true"></div>
<button class="avit-back-top" type="button" aria-label="Back to top">↑</button>

<style is:global>
  .avit-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 9999;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.035);
  }

  .avit-progress span {
    display: block;
    width: var(--avit-scroll-progress, 0%);
    height: 100%;
    background: linear-gradient(90deg, #20dfff, #8261ff 54%, #d85bff);
    box-shadow: 0 0 22px rgba(51, 222, 255, 0.62);
    transition: width 90ms linear;
  }

  .avit-cursor-aura {
    position: fixed;
    left: 0;
    top: 0;
    width: 520px;
    height: 520px;
    border-radius: 999px;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transform: translate3d(calc(var(--avit-x, 50vw) - 50%), calc(var(--avit-y, 50vh) - 50%), 0);
    background:
      radial-gradient(circle at center, rgba(37, 215, 255, 0.105), rgba(127, 91, 255, 0.07) 28%, transparent 68%);
    filter: blur(2px);
    mix-blend-mode: screen;
    transition: opacity 300ms ease;
  }

  .avit-pointer .avit-cursor-aura {
    opacity: 1;
  }

  .avit-noise-layer,
  .avit-scanline-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9998;
  }

  .avit-noise-layer {
    opacity: 0.035;
    mix-blend-mode: soft-light;
    background-image:
      radial-gradient(circle at 17% 19%, rgba(255,255,255,0.9) 0 1px, transparent 1px),
      radial-gradient(circle at 83% 71%, rgba(255,255,255,0.7) 0 1px, transparent 1px),
      radial-gradient(circle at 31% 83%, rgba(255,255,255,0.55) 0 1px, transparent 1px),
      radial-gradient(circle at 61% 37%, rgba(255,255,255,0.8) 0 1px, transparent 1px);
    background-size: 77px 77px, 113px 113px, 139px 139px, 191px 191px;
  }

  .avit-scanline-layer {
    opacity: 0.055;
    background: repeating-linear-gradient(180deg, transparent 0 4px, rgba(255,255,255,0.18) 5px, transparent 6px);
    mask-image: linear-gradient(180deg, transparent, #000 18%, #000 88%, transparent);
  }

  .avit-back-top {
    position: fixed;
    right: 1.15rem;
    bottom: 1.15rem;
    z-index: 9000;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(8, 11, 18, 0.68);
    color: #dff8ff;
    box-shadow: 0 18px 42px rgba(0,0,0,0.36), inset 0 1px 0 rgba(255,255,255,0.12);
    backdrop-filter: blur(20px);
    cursor: pointer;
    opacity: 0;
    transform: translateY(16px) scale(0.92);
    transition: opacity 220ms ease, transform 220ms ease, border-color 220ms ease;
  }

  .avit-back-top.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .avit-back-top:hover {
    border-color: rgba(51, 222, 255, 0.58);
    transform: translateY(-3px) scale(1.02);
  }

  .avit-motion-ready .avit-reveal {
    opacity: 0;
    transform: translateY(26px);
    filter: blur(8px);
    transition:
      opacity 760ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 760ms cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 760ms cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: var(--avit-delay, 0ms);
    will-change: transform, opacity, filter;
  }

  .avit-motion-ready .avit-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .magnetic-ready .btn,
  .magnetic-ready .text-link,
  .magnetic-ready .nav-cta {
    will-change: transform;
  }

  .tilt-ready .service-tile,
  .tilt-ready .premium-project-card,
  .tilt-ready .project-card,
  .tilt-ready .method-card,
  .tilt-ready .signature-card,
  .tilt-ready .scope-card,
  .tilt-ready .case-panel,
  .tilt-ready .intake-card {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .service-tile,
  .premium-project-card,
  .project-card,
  .method-card,
  .signature-card,
  .scope-card,
  .case-panel,
  .intake-card,
  .btn {
    position: relative;
  }

  .service-tile::after,
  .premium-project-card::after,
  .project-card::after,
  .method-card::after,
  .signature-card::after,
  .scope-card::after,
  .case-panel::after,
  .intake-card::after,
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 0 32%, rgba(255,255,255,0.16) 45%, transparent 58% 100%);
    opacity: 0;
    transform: translateX(-26%);
    transition: opacity 280ms ease, transform 620ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .service-tile:hover::after,
  .premium-project-card:hover::after,
  .project-card:hover::after,
  .method-card:hover::after,
  .signature-card:hover::after,
  .scope-card:hover::after,
  .case-panel:hover::after,
  .intake-card:hover::after,
  .btn:hover::after {
    opacity: 1;
    transform: translateX(26%);
  }

  .avit-page-enter main {
    animation: avitPageEnter 520ms ease both;
  }

  @keyframes avitPageEnter {
    from { opacity: 0; transform: translateY(10px); filter: blur(6px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  @media (max-width: 768px) {
    .avit-cursor-aura,
    .avit-noise-layer,
    .avit-scanline-layer {
      display: none;
    }

    .avit-back-top {
      width: 44px;
      height: 44px;
      right: 0.85rem;
      bottom: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avit-progress span,
    .avit-back-top,
    .avit-motion-ready .avit-reveal,
    .avit-page-enter main,
    .service-tile::after,
    .premium-project-card::after,
    .project-card::after,
    .method-card::after,
    .signature-card::after,
    .scope-card::after,
    .case-panel::after,
    .intake-card::after,
    .btn::after {
      animation: none !important;
      transition: none !important;
      transform: none !important;
      filter: none !important;
    }

    .avit-motion-ready .avit-reveal {
      opacity: 1 !important;
    }
  }
</style>

<script>
  (function initMotionSystem() {
    const root = document.documentElement;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    root.classList.add('avit-page-enter');

    const progress = document.querySelector('.avit-progress span');
    const backTop = document.querySelector('.avit-back-top');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const pct = Math.min(100, Math.max(0, (scrollTop / max) * 100));
      root.style.setProperty('--avit-scroll-progress', pct + '%');
      if (backTop) backTop.classList.toggle('is-visible', scrollTop > 640);
    }

    updateProgress();
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });

    if (backTop) {
      backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' }));
    }

    if (!prefersReduced) {
      root.classList.add('avit-motion-ready');
      const revealSelectors = [
        '.section-label', '.section-title', '.section-subtitle', '.section-intro',
        '.signature-card', '.service-tile', '.credential-cloud span', '.premium-project-card',
        '.method-card', '.scope-card', '.case-panel', '.timeline-item', '.contact-method',
        '.intake-card', '.project-card', '.project-category', '.case-hero-copy', '.case-visual'
      ];
      const candidates = Array.from(document.querySelectorAll(revealSelectors.join(',')))
        .filter((el) => !el.closest('.hero'));

      candidates.forEach((el, i) => {
        el.classList.add('avit-reveal');
        const rowDelay = Math.min((i % 8) * 65, 455);
        el.style.setProperty('--avit-delay', rowDelay + 'ms');
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });

      candidates.forEach((el) => observer.observe(el));

      if (window.matchMedia('(pointer: fine)').matches) {
        root.classList.add('avit-pointer', 'tilt-ready', 'magnetic-ready');
        let cursorFrame;
        document.addEventListener('pointermove', (event) => {
          if (cursorFrame) cancelAnimationFrame(cursorFrame);
          cursorFrame = requestAnimationFrame(() => {
            root.style.setProperty('--avit-x', event.clientX + 'px');
            root.style.setProperty('--avit-y', event.clientY + 'px');
          });
        }, { passive: true });

        const tiltItems = Array.from(document.querySelectorAll('.service-tile, .premium-project-card, .project-card, .method-card, .signature-card, .scope-card, .case-panel, .intake-card'));
        tiltItems.forEach((card) => {
          card.addEventListener('pointermove', (event) => {
            const rect = card.getBoundingClientRect();
            const x = event.clientX - rect.left;
            const y = event.clientY - rect.top;
            const rotateY = ((x / rect.width) - 0.5) * 7;
            const rotateX = ((0.5 - y / rect.height)) * 7;
            card.style.transform = `perspective(900px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-3px)`;
          });
          card.addEventListener('pointerleave', () => {
            card.style.transform = '';
          });
        });

        const magneticItems = Array.from(document.querySelectorAll('.btn, .text-link, .nav-cta'));
        magneticItems.forEach((item) => {
          item.addEventListener('pointermove', (event) => {
            const rect = item.getBoundingClientRect();
            const x = ((event.clientX - rect.left) / rect.width - 0.5) * 12;
            const y = ((event.clientY - rect.top) / rect.height - 0.5) * 8;
            item.style.transform = `translate(${x}px, ${y}px)`;
          });
          item.addEventListener('pointerleave', () => {
            item.style.transform = '';
          });
        });
      }

      document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
    }
  })();
</script>
