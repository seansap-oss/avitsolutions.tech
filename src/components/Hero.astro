---
const { title1 = 'We Design.', title2 = 'We Integrate.', title3 = 'We Elevate.' } = Astro.props;

const cards = [
  { title: 'AV Solutions', text: 'Immersive audio, visual and control experiences.', href: '/av-solutions', image: '/service-media/boardroom.webp', className: 'card-av' },
  { title: 'IT Solutions', text: 'Secure systems, smart networks and custom software.', href: '/it-solutions', image: '/service-media/hybrid-software.webp', className: 'card-it' },
  { title: 'Projects', text: 'Engineered solutions, delivered with precision.', href: '/projects', image: '/portfolio-media/avit-portfolio-hero.webp', className: 'card-projects' },
  { title: 'Smart Integration', text: 'Connected rooms, automation and intuitive control.', href: '/av-solutions#business', image: '/service-media/classroom.webp', className: 'card-smart' },
  { title: 'Contact', text: 'Let’s design, integrate and elevate together.', href: '/contact', image: '/service-media/control-room.webp', className: 'card-contact' },
];
---

<section class="phase16-hero" aria-label="AviT Solutions hero">
  <div class="ambient" aria-hidden="true">
    <span class="binary b1">01001101 101001</span>
    <span class="binary b2">11010 001101 011</span>
    <span class="music m1">♪ ♫ ♩</span>
    <span class="music m2">♬ ♩ ♪</span>
    <span class="wave">⌁⌁⌁⌁⌁⌁⌁</span>
    <span class="barcode">|||| ||| |||||| ||</span>
    <span class="qr">▦</span>
    <span class="circuit c1"></span>
    <span class="circuit c2"></span>
  </div>

  <div class="container hero-shell">
    <div class="crt-frame">
      <div class="crt-screen">
        <div class="terminal-line">&gt; AVIT SOLUTIONS.SYSTEM_</div>
        <h1 class="terminal-headline" aria-label={`${title1} ${title2} ${title3}`}>
          <span data-type-line={title1}></span>
          <span data-type-line={title2}></span>
          <span data-type-line={title3}></span><i class="cursor" aria-hidden="true"></i>
        </h1>
        <div class="terminal-footer">TECHNOLOGY <b>·</b> INNOVATION <b>·</b> EXPERIENCE</div>
      </div>
      <div class="crt-controls" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    </div>

    <div class="hero-card-deck" aria-label="AviT services">
      {cards.map((card) => (
        <a class={`signature-card ${card.className}`} href={card.href} data-magnetic-card>
          <div class="card-sheen"></div>
          <div class="card-copy">
            <h2>{card.title}</h2>
            <p>{card.text}</p>
          </div>
          <div class="card-photo-wrap">
            <img src={card.image} alt={`${card.title} by AviT Solutions`} loading={card.className === 'card-projects' ? 'eager' : 'lazy'} />
          </div>
          <span class="card-arrow">↗</span>
        </a>
      ))}
    </div>

    <a class="scroll-cue" href="#what-we-do"><span>⌄</span>Scroll to explore</a>
  </div>

  <button class="ai-launcher" id="aiLauncher" type="button" aria-expanded="false" aria-controls="aiPanel">
    <span class="ai-orb">●</span><span><strong>AI Assistance</strong><small>How can I help you?</small></span>
  </button>
  <div class="ai-panel" id="aiPanel" hidden>
    <div class="ai-panel-head"><strong>AviT AI Assistance</strong><button id="aiClose" type="button" aria-label="Close">×</button></div>
    <p>Hello. Tell us whether you need AV, IT, smart integration, or project support.</p>
    <div class="ai-actions"><a href="/contact">Contact support</a><a href="/av-solutions">Explore AV</a><a href="/it-solutions">Explore IT</a></div>
  </div>
</section>

<script>
  function initPhase16Hero() {
    const lines = Array.from(document.querySelectorAll('[data-type-line]'));
    if (lines.length && !lines[0].dataset.typed) {
      lines.forEach((line) => { line.textContent = ''; line.dataset.typed = '1'; });
      let lineIndex = 0;
      let charIndex = 0;
      const typeNext = () => {
        const line = lines[lineIndex];
        const text = line.getAttribute('data-type-line') || '';
        line.textContent = text.slice(0, charIndex + 1);
        charIndex += 1;
        if (charIndex >= text.length) { lineIndex += 1; charIndex = 0; }
        if (lineIndex < lines.length) window.setTimeout(typeNext, 42 + Math.random() * 35);
      };
      window.setTimeout(typeNext, 350);
    }

    document.querySelectorAll('[data-magnetic-card]').forEach((card) => {
      if (card.dataset.bound) return;
      card.dataset.bound = '1';
      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        card.style.setProperty('--rx', `${-y * 7}deg`);
        card.style.setProperty('--ry', `${x * 9}deg`);
        card.style.setProperty('--mx', `${(x + 0.5) * 100}%`);
        card.style.setProperty('--my', `${(y + 0.5) * 100}%`);
      });
      card.addEventListener('pointerleave', () => { card.style.removeProperty('--rx'); card.style.removeProperty('--ry'); });
    });

    const launcher = document.getElementById('aiLauncher');
    const panel = document.getElementById('aiPanel');
    const close = document.getElementById('aiClose');
    if (launcher && panel && !launcher.dataset.bound) {
      launcher.dataset.bound = '1';
      launcher.addEventListener('click', () => { panel.hidden = !panel.hidden; launcher.setAttribute('aria-expanded', String(!panel.hidden)); });
      close?.addEventListener('click', () => { panel.hidden = true; launcher.setAttribute('aria-expanded', 'false'); });
    }
  }
  document.addEventListener('astro:page-load', initPhase16Hero);
  initPhase16Hero();
</script>

<style>
  .phase16-hero{position:relative;min-height:100vh;padding:7.2rem 0 3rem;overflow:hidden;background:radial-gradient(circle at 50% 8%,rgba(255,255,255,.08),transparent 28rem),linear-gradient(180deg,#151719 0%,#090a0b 72%,#050606 100%);isolation:isolate}
  .phase16-hero:before{content:"";position:absolute;inset:0;opacity:.28;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:74px 74px;mask-image:linear-gradient(to bottom,#000,transparent 90%)}
  .hero-shell{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center}
  .crt-frame{width:min(680px,82vw);padding:14px 70px 14px 14px;border:1px solid rgba(255,255,255,.24);border-radius:34px;background:linear-gradient(145deg,#55595a,#242627 22%,#0c0d0e 70%,#353839);box-shadow:0 30px 90px rgba(0,0,0,.65),inset 0 1px rgba(255,255,255,.22);position:relative}
  .crt-screen{position:relative;min-height:270px;padding:2rem 2.4rem;border-radius:25px;background:radial-gradient(circle at 48% 45%,#17201b,#050807 72%);border:2px solid #070808;box-shadow:inset 0 0 70px #000,inset 0 0 0 3px rgba(255,255,255,.06);overflow:hidden}
  .crt-screen:after{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(255,255,255,.025) 0 1px,transparent 1px 4px);mix-blend-mode:screen}
  .terminal-line,.terminal-footer,.terminal-headline{font-family:"Courier New",monospace}.terminal-line{font-size:.76rem;letter-spacing:.08em;color:#c7cec8}.terminal-headline{margin:1.25rem 0 1.4rem;color:#eef2ea;font-size:clamp(2rem,4vw,3.7rem);line-height:1.08;letter-spacing:.055em;text-transform:uppercase;text-shadow:0 0 13px rgba(230,240,225,.35)}
  .terminal-headline span{display:block;min-height:1.08em}.cursor{display:inline-block;width:.42em;height:.82em;margin-left:.16em;background:#e7ece4;vertical-align:-.04em;animation:blink .72s steps(1) infinite}.terminal-footer{font-size:.75rem;letter-spacing:.22em;color:#a7aca7}.terminal-footer b{color:#c5a46a;margin:0 .7rem}.crt-controls{position:absolute;right:20px;top:28px;bottom:28px;width:34px;display:flex;flex-direction:column;gap:12px}.crt-controls i{height:34px;border-radius:8px;background:linear-gradient(#222,#090a0a);border:1px solid rgba(255,255,255,.08)}
  .hero-card-deck{width:100%;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));align-items:end;gap:1rem;margin-top:1.3rem;perspective:1300px}
  .signature-card{--rx:0deg;--ry:0deg;--base-rotate:0deg;position:relative;min-height:330px;padding:1.25rem;border-radius:23px;overflow:hidden;color:#f5f5f2;border:1px solid rgba(228,215,190,.48);background:linear-gradient(160deg,rgba(91,94,93,.62),rgba(19,20,20,.96) 45%,#0a0b0b);box-shadow:0 24px 46px rgba(0,0,0,.46),inset 0 1px rgba(255,255,255,.18);transform:translateY(var(--lift,0)) rotate(var(--base-rotate)) rotateX(var(--rx)) rotateY(var(--ry));transform-style:preserve-3d;transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s ease,border-color .35s ease;will-change:transform}
  .signature-card:hover{--lift:-18px;border-color:rgba(255,238,206,.8);box-shadow:0 38px 72px rgba(0,0,0,.62),0 0 28px rgba(211,183,132,.16),inset 0 1px rgba(255,255,255,.25);color:#fff}.card-av{--base-rotate:-3deg}.card-it{--base-rotate:-1.5deg}.card-projects{min-height:390px;z-index:3}.card-smart{--base-rotate:1.5deg}.card-contact{--base-rotate:3deg}
  .card-sheen{position:absolute;inset:0;background:radial-gradient(circle at var(--mx,50%) var(--my,20%),rgba(255,255,255,.22),transparent 34%);opacity:.5;pointer-events:none}.card-copy{position:relative;z-index:2}.card-copy h2{font-family:"Courier New",monospace;text-transform:uppercase;font-size:clamp(1.1rem,1.45vw,1.55rem);line-height:1.05;letter-spacing:.02em}.card-copy p{margin-top:.65rem;color:rgba(238,238,232,.68);font-size:.76rem;line-height:1.55}.card-photo-wrap{position:absolute;left:1rem;right:1rem;bottom:1rem;height:48%;border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,.16);background:#111}.card-photo-wrap img{width:100%;height:100%;object-fit:cover;filter:saturate(.55) contrast(1.08) brightness(.78);transition:transform .6s ease,filter .45s ease}.signature-card:hover img{transform:scale(1.06);filter:saturate(.75) contrast(1.08) brightness(.88)}.card-photo-wrap:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(5,6,6,.55))}.card-arrow{position:absolute;z-index:3;right:1rem;bottom:1rem;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:rgba(0,0,0,.7);border:1px solid rgba(255,255,255,.22)}
  .ambient{position:absolute;inset:0;z-index:1;pointer-events:none;color:#d8d7d2;opacity:.3}.ambient span{position:absolute;font-family:"Courier New",monospace}.binary{font-size:.72rem;letter-spacing:.3em}.b1{top:14%;left:7%;animation:drift 14s ease-in-out infinite}.b2{top:17%;right:5%;animation:drift 17s ease-in-out infinite reverse}.music{font-family:Georgia,serif!important;font-size:2rem}.m1{top:22%;left:2%;color:#eee;animation:float 10s ease-in-out infinite}.m2{top:28%;right:4%;color:#aaa;animation:float 13s ease-in-out infinite reverse}.wave{top:44%;left:10%;font-size:1.5rem}.barcode{top:38%;right:8%;letter-spacing:.15em}.qr{right:16%;top:16%;font-size:2rem}.circuit{width:220px;height:110px;border-top:1px solid #b7aa91;border-right:1px solid #b7aa91}.c1{left:-20px;top:33%;transform:skewY(-10deg)}.c2{right:-20px;top:31%;transform:scaleX(-1) skewY(-10deg)}
  .scroll-cue{margin-top:1.7rem;color:#9a9b98;text-transform:uppercase;letter-spacing:.28em;font-size:.62rem;text-align:center}.scroll-cue span{display:block;font-size:2rem;line-height:.8;color:#ddd;animation:bob 1.6s ease-in-out infinite}
  .ai-launcher{position:fixed;right:1.3rem;bottom:1.3rem;z-index:50;display:flex;align-items:center;gap:.75rem;padding:.65rem 1rem .65rem .65rem;border-radius:999px;border:1px solid rgba(232,216,187,.46);background:rgba(17,18,18,.91);color:#f5f4ef;box-shadow:0 16px 40px rgba(0,0,0,.42);backdrop-filter:blur(18px);cursor:pointer}.ai-launcher span:last-child{display:grid;text-align:left}.ai-launcher strong{font-size:.8rem;text-transform:uppercase;letter-spacing:.08em}.ai-launcher small{font-size:.68rem;color:#b7b7b2}.ai-orb{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 35% 30%,#fff,#999 16%,#161717 55%);color:#d2b37b;box-shadow:0 0 20px rgba(210,179,123,.18)}
  .ai-panel{position:fixed;right:1.3rem;bottom:6.2rem;z-index:50;width:min(340px,calc(100vw - 2rem));padding:1rem;border-radius:20px;background:rgba(18,19,19,.97);border:1px solid rgba(232,216,187,.35);box-shadow:0 28px 70px rgba(0,0,0,.55);color:#eee}.ai-panel-head{display:flex;justify-content:space-between;align-items:center}.ai-panel-head button{border:0;background:none;color:#fff;font-size:1.5rem;cursor:pointer}.ai-panel p{margin:.8rem 0;color:#bbb;font-size:.88rem}.ai-actions{display:grid;gap:.5rem}.ai-actions a{padding:.65rem .75rem;border-radius:10px;background:#292b2b;color:#eee;border:1px solid rgba(255,255,255,.09)}
  @keyframes blink{50%{opacity:0}}@keyframes drift{50%{transform:translate(18px,12px)}}@keyframes float{50%{transform:translateY(-18px) rotate(4deg)}}@keyframes bob{50%{transform:translateY(6px)}}
  [data-theme="light"] .phase16-hero{background:radial-gradient(circle at 50% 8%,#fff,transparent 28rem),linear-gradient(180deg,#d9d9d5,#bfc0bc 70%,#e7e7e3)}
  [data-theme="light"] .signature-card{background:linear-gradient(160deg,#f8f8f5,#c8cac7 55%,#aeb0ad);color:#131414;border-color:rgba(40,40,38,.32)}[data-theme="light"] .card-copy p{color:rgba(20,21,21,.68)}
  @media(max-width:980px){.hero-card-deck{grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch}.card-projects{grid-column:1/-1;grid-row:1;min-height:360px}.signature-card{min-height:300px;--base-rotate:0deg}.crt-frame{width:min(700px,94vw)}}
  @media(max-width:620px){.phase16-hero{padding-top:6rem}.crt-frame{padding:9px 48px 9px 9px;border-radius:23px}.crt-screen{min-height:230px;padding:1.35rem 1.15rem;border-radius:18px}.terminal-headline{font-size:clamp(1.65rem,8.5vw,2.35rem)}.terminal-footer{font-size:.55rem;letter-spacing:.1em}.crt-controls{right:12px;width:24px}.hero-card-deck{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding:.5rem .25rem 1.5rem;gap:.75rem}.signature-card{min-width:82vw;scroll-snap-align:center;min-height:335px}.card-projects{min-height:365px}.ai-launcher small{display:none}.ambient{opacity:.2}}
  @media(prefers-reduced-motion:reduce){.ambient span,.cursor,.scroll-cue span{animation:none}.signature-card{transition:none}}
</style>
