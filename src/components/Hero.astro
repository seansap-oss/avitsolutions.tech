---
const { title1, title2, subtitle, ctaText, ctaLink, secondaryText, secondaryLink } = Astro.props;
---

<section class="hero">
  <div class="hero-bg"></div>
  <canvas id="avCanvas" class="particle-canvas"></canvas>
  <div class="hero-grid-overlay"></div>
  <div class="hero-glow-1"></div>
  <div class="hero-glow-2"></div>
  <div class="hero-accent-line"></div>
  <div class="container hero-content">
    <div class="hero-badge glass">
      <span class="hero-badge-dot"></span>
      AV + IT Integration Specialists
    </div>
    <h1 class="hero-title" id="heroTitle1">
      {title1}
    </h1>
    <h1 class="hero-title hero-title-2" id="heroTitle2">
      {title2}
    </h1>
    <p class="hero-subtitle">{subtitle}</p>
    <div class="hero-actions">
      <a href={ctaLink} class="btn btn-primary hero-cta">{ctaText}</a>
      {secondaryText && secondaryLink && (
        <a href={secondaryLink} class="btn btn-secondary">{secondaryText}</a>
      )}
    </div>
    <div class="hero-scroll-indicator">
      <span class="scroll-text">Scroll</span>
      <span class="scroll-line"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 6rem 0 4rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 30% 40%, rgba(0, 229, 255, 0.07) 0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 80% 60%, rgba(77, 138, 255, 0.05) 0%, transparent 50%),
      linear-gradient(180deg, #08090a 0%, #0a0b0c 30%, #0e1117 70%, #0a0b0c 100%);
  }

  .particle-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 229, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 229, 255, 0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    z-index: 1;
    pointer-events: none;
  }

  .hero-glow-1 {
    position: absolute;
    top: 10%;
    left: 5%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 229, 255, 0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    animation: heroFloat1 8s ease-in-out infinite;
  }

  .hero-glow-2 {
    position: absolute;
    bottom: 10%;
    right: 15%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(77, 138, 255, 0.06) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    animation: heroFloat2 10s ease-in-out infinite;
  }

  .hero-accent-line {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, transparent, var(--accent), transparent);
    opacity: 0.3;
    z-index: 2;
  }

  @keyframes heroFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -30px) scale(1.1); }
  }

  @keyframes heroFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-20px, 20px) scale(1.05); }
  }

  .hero-content {
    position: relative;
    z-index: 3;
    max-width: 800px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 2rem;
    animation: fadeIn 0.6s ease-out;
  }

  .hero-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulseGlow 2s ease-in-out infinite;
  }

  .hero-title {
    font-size: clamp(2.8rem, 6vw, 4.8rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .hero-title span {
    display: inline-block;
    opacity: 0;
    animation: fadeInUp 0.5s ease-out forwards;
  }

  .hero-title-2 {
    color: var(--accent);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--text-secondary);
    max-width: 580px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    opacity: 0;
    animation: fadeInUp 0.5s ease-out 0.3s forwards;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeInUp 0.5s ease-out 0.5s forwards;
  }

  .hero-cta {
    animation: pulseGlow 3s ease-in-out infinite;
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    animation: fadeIn 1s ease-out 1.5s forwards;
  }

  .scroll-text {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--accent-dim), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.5); }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 5rem 0 3rem;
      min-height: 100vh;
      min-height: 100dvh;
    }
    .hero-accent-line { display: none; }
    .hero-scroll-indicator { display: none; }
    .hero-grid-overlay { background-size: 40px 40px; }
    .hero-glow-1, .hero-glow-2 {
      width: 300px;
      height: 300px;
    }
    .hero-badge {
      font-size: 0.7rem;
      padding: 0.35rem 0.85rem;
    }
    .hero-actions {
      gap: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 4.5rem 0 2.5rem;
    }
    .hero-content {
      max-width: 100%;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }
    .hero-title {
      letter-spacing: -0.02em;
    }
  }
</style>

<script>
  function animateTitle(id, delay) {
    const el = document.getElementById(id);
    if (!el) return;
    const text = el.textContent;
    el.innerHTML = '';
    text.split('').forEach((char, i) => {
      const span = document.createElement('span');
      span.textContent = char === ' ' ? '\u00A0' : char;
      span.style.animationDelay = `${delay + i * 0.025}s`;
      el.appendChild(span);
    });
  }
  animateTitle('heroTitle1', 0);
  animateTitle('heroTitle2', 0.6);

  (function initAVBackground() {
    const canvas = document.getElementById('avCanvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    let elements = [];
    let mouse = { x: -1000, y: -1000 };
    let frame = 0;

    function resize() {
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;
    }

    const notes = ['♪', '♫', '♬', '♩'];
    const symbols = ['01', '10', '⚡', '►', '◄', '⬡', '⏵'];

    let totalCount;

    function getCounts() {
      const area = canvas.width * canvas.height;
      const isMobile = window.innerWidth < 768;
      const isTablet = window.innerWidth < 1024 && window.innerWidth >= 768;
      const divisor = isMobile ? 14000 : isTablet ? 8000 : 5000;
      const cap = isMobile ? 50 : isTablet ? 90 : 140;
      totalCount = Math.min(Math.floor(area / divisor), cap);
      return {
        notes: Math.floor(totalCount * 0.2),
        binary: Math.floor(totalCount * 0.25),
        packets: Math.floor(totalCount * 0.2),
        numbers: Math.floor(totalCount * 0.2),
        pixels: Math.floor(totalCount * 0.15),
      };
    }

    class AVElement {
      constructor(type) {
        this.type = type;
        this.reset();
      }

      reset() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.size = Math.random() * 17 + 10;
        this.alpha = Math.random() * 0.3 + 0.35;
        this.hueShift = Math.random() * 360;
        this.life = Math.random() * 300 + 200;
        this.maxLife = this.life;
        this.rotation = (Math.random() - 0.5) * 0.4;

        switch (this.type) {
          case 'note':
            this.char = notes[Math.floor(Math.random() * notes.length)];
            this.vx = (Math.random() - 0.5) * 0.2;
            this.vy = -Math.random() * 0.6 - 0.2;
            this.sway = Math.random() * 0.02;
            this.swayAmp = Math.random() * 0.5 + 0.3;
            this.baseX = this.x;
            this.hue = Math.random() * 360;
            this.sat = 80;
            this.light = 65;
            break;

          case 'binary':
            this.char = Math.random() > 0.5 ? '0' : '1';
            this.vx = (Math.random() - 0.5) * 0.1;
            this.vy = Math.random() * 0.8 + 0.2;
            this.hue = Math.random() * 360;
            this.sat = 85;
            this.light = 70;
            break;

          case 'packet':
            this.char = symbols[Math.floor(Math.random() * symbols.length)];
            this.vx = (Math.random() - 0.5) * 0.3;
            this.vy = (Math.random() - 0.5) * 0.15;
            this.w = Math.random() * 24 + 17;
            this.h = Math.random() * 14 + 10;
            this.pulse = Math.random() * Math.PI * 2;
            this.hue = Math.random() * 360;
            this.sat = 75;
            this.light = 60;
            break;

          case 'number':
            this.char = Math.floor(Math.random() * 10).toString();
            this.vx = (Math.random() - 0.5) * 0.25;
            this.vy = (Math.random() - 0.5) * 0.25 - 0.1;
            this.hue = Math.random() * 360;
            this.sat = 70;
            this.light = 65;
            break;

          case 'pixel':
            this.w = Math.random() * 7 + 4;
            this.h = this.w;
            this.vx = (Math.random() - 0.5) * 0.3;
            this.vy = (Math.random() - 0.5) * 0.3;
            this.hue = Math.random() * 360;
            this.sat = 90;
            this.light = 65;
            break;
        }
      }

      update() {
        this.life--;
        this.x += this.vx;
        this.y += this.vy;
        this.pulse = (this.pulse || 0) + 0.03;
        this.hueShift = (this.hueShift || 0) + 0.3;
        this.hue = (this.hue + 0.15) % 360;

        if (this.type === 'note') {
          this.x += Math.sin(frame * this.sway + this.baseX * 0.01) * this.swayAmp * 0.05;
          this.alpha *= 0.998;
        }

        if (this.life <= 0) {
          this.reset();
          this.life = this.maxLife;
        }

        if (this.x < -50) this.x = canvas.width + 20;
        if (this.x > canvas.width + 50) this.x = -20;
        if (this.y < -50) this.y = canvas.height + 20;
        if (this.y > canvas.height + 50) this.y = -20;
      }

      draw(ctx) {
        const lifeRatio = this.life / this.maxLife;
        const fadeAlpha = this.alpha * Math.min(lifeRatio * 2, 1);
        const hue = this.hue % 360;
        const sat = this.sat || 80;
        const light = this.light || 65;

        ctx.save();
        ctx.globalAlpha = fadeAlpha;

        switch (this.type) {
          case 'note':
            ctx.font = `bold ${this.size}px serif`;
            ctx.fillStyle = `hsl(${hue}, ${sat}%, ${light}%)`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.shadowColor = `hsla(${hue}, ${sat}%, ${light}%, 0.3)`;
            ctx.shadowBlur = 8;
            ctx.fillText(this.char, this.x, this.y);
            ctx.shadowBlur = 0;
            break;

          case 'binary':
            ctx.font = `bold ${this.size * 0.9}px "Courier New", monospace`;
            ctx.fillStyle = `hsl(${hue}, ${sat}%, ${light}%)`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.shadowColor = `hsla(${hue}, ${sat}%, ${light}%, 0.3)`;
            ctx.shadowBlur = 6;
            ctx.fillText(this.char, this.x, this.y);
            ctx.shadowBlur = 0;
            break;

          case 'packet':
            ctx.translate(this.x, this.y);
            const pw = this.w + Math.sin(this.pulse) * 3;
            const ph = this.h + Math.sin(this.pulse * 1.5) * 2;
            ctx.strokeStyle = `hsl(${hue}, ${sat}%, ${light}%)`;
            ctx.lineWidth = 1.5;
            ctx.shadowColor = `hsla(${hue}, ${sat}%, ${light}%, 0.3)`;
            ctx.shadowBlur = 10;
            ctx.strokeRect(-pw / 2, -ph / 2, pw, ph);
            ctx.shadowBlur = 0;
            ctx.fillStyle = `hsla(${hue}, ${sat}%, ${light}%, 0.1)`;
            ctx.fillRect(-pw / 2, -ph / 2, pw, ph);
            if (this.char) {
              ctx.font = `bold ${this.size * 0.6}px "Courier New", monospace`;
              ctx.fillStyle = `hsl(${hue}, ${sat}%, ${light + 10}%)`;
              ctx.textAlign = 'center';
              ctx.textBaseline = 'middle';
              ctx.fillText(this.char, 0, 0);
            }
            break;

          case 'number':
            ctx.font = `bold ${this.size}px "Courier New", monospace`;
            ctx.fillStyle = `hsl(${hue}, ${sat}%, ${light}%)`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.shadowColor = `hsla(${hue}, ${sat}%, ${light}%, 0.3)`;
            ctx.shadowBlur = 6;
            ctx.fillText(this.char, this.x, this.y);
            ctx.shadowBlur = 0;
            break;

          case 'pixel':
            ctx.fillStyle = `hsl(${hue}, ${sat}%, ${light}%)`;
            ctx.shadowColor = `hsla(${hue}, ${sat}%, ${light}%, 0.4)`;
            ctx.shadowBlur = 4;
            ctx.fillRect(this.x, this.y, this.w, this.h);
            ctx.shadowBlur = 0;
            ctx.strokeStyle = `hsla(${hue}, ${sat}%, ${light + 10}%, 0.3)`;
            ctx.lineWidth = 0.5;
            ctx.strokeRect(this.x, this.y, this.w, this.h);
            break;
        }

        ctx.restore();
      }
    }

    function init() {
      resize();
      const counts = getCounts();
      elements = [];

      for (let i = 0; i < counts.notes; i++) elements.push(new AVElement('note'));
      for (let i = 0; i < counts.binary; i++) elements.push(new AVElement('binary'));
      for (let i = 0; i < counts.packets; i++) elements.push(new AVElement('packet'));
      for (let i = 0; i < counts.numbers; i++) elements.push(new AVElement('number'));
      for (let i = 0; i < counts.pixels; i++) elements.push(new AVElement('pixel'));
    }

    function drawConnections() {
      const t = frame * 0.005;
      for (let i = 0; i < elements.length; i++) {
        for (let j = i + 1; j < elements.length; j++) {
          const a = elements[i];
          const b = elements[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 130) {
            const alpha = (1 - dist / 130) * 0.2;
            const hue = ((a.hue || 180) + (b.hue || 180)) / 2 + Math.sin(t + i) * 30;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = `hsla(${hue}, 80%, 65%, ${alpha})`;
            ctx.lineWidth = 0.8;
            ctx.stroke();
          }
        }
      }
    }

    function drawSignalWaves() {
      const t = frame * 0.02;
      ctx.lineWidth = 1.5;

      for (let wave = 0; wave < 3; wave++) {
        const offset = wave * 100 + t * 30;
        const hue = (wave * 120 + t * 20) % 360;
        ctx.strokeStyle = `hsla(${hue}, 80%, 60%, 0.08)`;
        ctx.beginPath();
        for (let x = 0; x < canvas.width; x += 3) {
          const y = canvas.height * 0.5 + Math.sin((x + offset) * 0.008) * 40 + Math.sin((x + offset) * 0.02) * 20;
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
    }

    function animate() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      frame++;

      elements.forEach(el => {
        el.update();
        el.draw(ctx);
      });

      drawConnections();
      if (frame % 2 === 0) drawSignalWaves();

      animId = requestAnimationFrame(animate);
    }

    let animId;
    init();
    animate();

    window.addEventListener('resize', () => {
      init();
    });

    canvas.addEventListener('mousemove', e => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;

      elements.forEach(el => {
        const dx = mouse.x - el.x;
        const dy = mouse.y - el.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 150) {
          el.vx += dx * 0.00008;
          el.vy += dy * 0.00008;
        }
      });
    });

    canvas.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });
  })();
</script>
