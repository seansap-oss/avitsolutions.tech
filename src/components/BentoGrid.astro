---
const { items, columns = 3 } = Astro.props;
---

<div class="bento-grid" style="--cols: {columns}">
  {items.map((item) => (
    <a href={item.link || '#'} class="bento-card" style={item.span ? `grid-column: span ${item.span}` : ''}>
      <div class="bento-icon">{item.icon}</div>
      <h3 class="bento-title">{item.title}</h3>
      <p class="bento-desc">{item.description}</p>
      {item.meta && <span class="bento-meta">{item.meta}</span>}
    </a>
  ))}
</div>

<style>
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    gap: 1rem;
  }

  .bento-card {
    position: relative;
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    transition: all var(--transition-base);
    text-decoration: none;
    color: var(--text-primary);
    overflow: hidden;
    cursor: pointer;
  }

  .bento-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(600px circle at var(--mx, 50%) var(--my, 50%), var(--accent-glow) 0%, transparent 60%);
    opacity: 0;
    transition: opacity var(--transition-base);
    pointer-events: none;
  }

  .bento-card:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }

  .bento-card:hover::before {
    opacity: 1;
  }

  .bento-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .bento-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .bento-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .bento-meta {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (max-width: 768px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll('.bento-card').forEach(card => {
    card.addEventListener('mousemove', e => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      card.style.setProperty('--mx', `${x}px`);
      card.style.setProperty('--my', `${y}px`);
    });
  });
</script>
