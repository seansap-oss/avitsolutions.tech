---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="AVIT Solutions — Audiovisual Integration & IT Software Development. From design to completion, we deliver AV solutions for corporate, residential, and government projects." />
    <meta name="theme-color" content="#0a0b0c" />
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('avit-theme');
        var theme = saved || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script is:inline>
      (function() {
        try {
          var data = JSON.parse(localStorage.getItem('avit-custom-images'));
          if (data) {
            var keys = Object.keys(data);
            if (keys.length) {
              var run = function() {
                keys.forEach(function(key) {
                  var imgs = document.querySelectorAll('img[data-image-key="' + key + '"]');
                  for (var i = 0; i < imgs.length; i++) {
                    imgs[i].src = data[key];
                  }
                });
              };
              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', run);
              } else {
                run();
              }
            }
          }
        } catch(e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>AVIT Solutions — AV Integration & IT Software Development</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
